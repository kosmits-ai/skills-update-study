+             flush_list()
+             flush_list()
+             flush_list()
+             flush_list()
+             flush_list()
+             flush_list()
+             flush_list()
+             flush_list()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flush_table()
+             flow.append(Paragraph(s[2:].strip(), H1))
+         elif s.startswith('## '):
+             flow.append(Paragraph(s[3:].strip(), H2))
+             flow.append(Spacer(1, 4))
+             flow.append(Spacer(1, 4))
+         elif s.startswith('### '):
+             flow.append(Paragraph(s[4:].strip(), H3))
+         elif s.startswith('#### '):
+             flow.append(Paragraph(s[5:].strip(), H4))
+         # Tables
+         elif '|' in s and s.strip().startswith('|'):
+             cells = [c.strip() for c in s.strip('|').split('|')]
+             if all(re.match(r'^[-:\s]+$', c) for c in cells):
+                 pass
+             else:
+                 table_rows.append(cells)
+         # Empty line
+         elif s == '':
+         # Blockquote
+         elif s.startswith('> '):
+             flow.append(Paragraph(s[2:].strip(), QUOTE))
+         # Lists
+         elif s.startswith('- ') or s.startswith('* '):
+             list_items.append(s[2:].strip())
+         # Horizontal rule
+         elif s == '---':
+             flow.append(Spacer(1, 8))
+         # Code
+         elif s.startswith('    '):
+             flow.append(Paragraph(f"<font name='Courier'>{s.strip()}</font>", SMALL))
+         # Body
+         else:
+             text = s
+             # Convert markdown bold to reportlab bold
+             text = re.sub(r'\*\*(.+?)\*\*', r'<b>\1</b>', text)
+             # Inline code
+             text = re.sub(r'`(.+?)`', r"<font name='Courier'>\1</font>", text)
+             flow.append(Paragraph(text, BODY))
+         i += 1
+     flush_list()
+     flush_table()
+     return flow
