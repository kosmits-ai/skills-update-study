+     section.bottom_margin = Cm(1.5)
+     # Header
+     header = section.header
+     h_para = header.paragraphs[0]
+     h_para.alignment = WD_ALIGN_PARAGRAPH.LEFT
+     run = h_para.add_run("PONOVO NOVO")
+     run.bold = True
+     run.font.size = Pt(9)
+     run.font.color.rgb = PRIMARY
+     # Tab to right with location
+     h_para.add_run("\t\t").font.size = Pt(9)
+     r2 = h_para.add_run("Šremčica · Belgrade")
+     r2.font.size = Pt(9)
+     r2.font.color.rgb = PRIMARY
+     # Footer
+     footer = section.footer
+     f_para = footer.paragraphs[0]
+     f_para.alignment = WD_ALIGN_PARAGRAPH.LEFT
+     fr1 = f_para.add_run("Ponovo Novo — Business Kickstart Manual")
+     fr1.font.size = Pt(8)
+     fr1.font.color.rgb = MUTED
+     f_para.add_run("\t\t").font.size = Pt(8)
+     fr2 = f_para.add_run("Built on Hormozi's $100M Trilogy · 2026")
+     fr2.font.size = Pt(8)
+     fr2.font.color.rgb = MUTED
+     # Set default font (NotoSans if available, otherwise Calibri)
+     style = doc.styles['Normal']
