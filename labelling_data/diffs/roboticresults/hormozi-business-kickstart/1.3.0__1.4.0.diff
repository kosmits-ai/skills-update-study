+                                 ('GRID', (0, 0), (-1, -1), 0.5, HexColor('#bdc3c7')),
+                                 ('ROWBACKGROUNDS', (0, 1), (-1, -1), [HexColor('#ffffff'), BG]),
+                                 ('LEFTPADDING', (0, 0), (-1, -1), 4),
+                                 ('RIGHTPADDING', (0, 0), (-1, -1), 4),
+                                 ('TOPPADDING', (0, 0), (-1, -1), 3),
+                                 ('BOTTOMPADDING', (0, 0), (-1, -1), 3),
+                             ]))
+             flow.append(t)
+             flow.append(Spacer(1, 6))
+             table_rows = []
+     while i < len(lines):
