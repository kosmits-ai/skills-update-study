+ #!/usr/bin/env python3
+ """Convert Ponovo Novo manual Markdown to A3 landscape PDF."""
+ import re
+ import sys
+ from reportlab.lib.pagesizes import A3
+ from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
+ from reportlab.lib.units import cm
+ from reportlab.lib.colors import HexColor
+ from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, PageBreak, Table, TableStyle
+ from reportlab.lib.enums import TA_LEFT, TA_CENTER, TA_JUSTIFY
+ from reportlab.pdfbase import pdfmetrics
+ from reportlab.pdfbase.ttfonts import TTFont
+ # Register NotoSans for Serbian (Cyrillic + Latin) support
+ pdfmetrics.registerFont(TTFont('NotoSans', '/tmp/NotoSans-Regular.ttf'))
+ pdfmetrics.registerFont(TTFont('NotoSans-Bold', '/tmp/NotoSans-Bold.ttf'))
+ OUTPUT = sys.argv[1] if len(sys.argv) > 1 else '/workspace/ponovo_novo_manual.pdf'
+ INPUT = sys.argv[2] if len(sys.argv) > 2 else '/tmp/ponovo_novo_manual.md'
+ # A3 landscape: 42.0 x 29.7 cm
+ PAGE_W, PAGE_H = A3[1], A3[0]  # landscape
+ # Colors
+ PRIMARY = HexColor('#1a3a52')
+ ACCENT = HexColor('#d35400')
+ TEXT = HexColor('#2c3e50')
+ MUTED = HexColor('#7f8c8d')
+ BG = HexColor('#ecf0f1')
+ styles = getSampleStyleSheet()
+ H1 = ParagraphStyle('H1', parent=styles['Heading1'], fontName='NotoSans-Bold',
+                     fontSize=26, textColor=PRIMARY, spaceAfter=12, spaceBefore=18, leading=30)
+ H2 = ParagraphStyle('H2', parent=styles['Heading2'], fontName='NotoSans-Bold',
+                     fontSize=20, textColor=PRIMARY, spaceAfter=10, spaceBefore=14, leading=24)
+ H3 = ParagraphStyle('H3', parent=styles['Heading3'], fontName='NotoSans-Bold',
+                     fontSize=15, textColor=ACCENT, spaceAfter=8, spaceBefore=10, leading=18)
+ H4 = ParagraphStyle('H4', parent=styles['Heading4'], fontName='NotoSans-Bold',
+                     fontSize=12, textColor=PRIMARY, spaceAfter=6, spaceBefore=8, leading=15)
+ BODY = ParagraphStyle('BODY', parent=styles['BodyText'], fontName='NotoSans',
+                       fontSize=10, textColor=TEXT, leading=14, alignment=TA_JUSTIFY, spaceAfter=4)
+ BODY_BOLD = ParagraphStyle('BODYB', parent=BODY, fontName='NotoSans-Bold')
+ QUOTE = ParagraphStyle('QUOTE', parent=BODY, fontSize=12, leftIndent=20, rightIndent=20,
+                        textColor=ACCENT, fontName='NotoSans-Bold', spaceAfter=10, spaceBefore=10)
+ TAGLINE = ParagraphStyle('TAG', parent=BODY, fontSize=14, textColor=ACCENT,
+                           fontName='NotoSans-Bold', alignment=TA_CENTER, spaceAfter=20)
+ SMALL = ParagraphStyle('SMALL', parent=BODY, fontSize=8, textColor=MUTED)
+ SMALL_BOLD = ParagraphStyle('SMALLB', parent=SMALL, fontName='NotoSans-Bold', textColor=PRIMARY)
+ def md_to_flowables(md):
+     flow = []
+     lines = md.split('\n')
+     i = 0
+     in_table = False
+     table_rows = []
+     list_items = []
+     def flush_list():
+         nonlocal list_items
+         if list_items:
+             for it in list_items:
+                 flow.append(Paragraph(f"• {it}", BODY))
+                 flow.append(Spacer(1, 1))
+             list_items = []
+     def flush_table():
+         nonlocal table_rows
+         if table_rows:
+             data = []
+             for row in table_rows:
+                 data.append([Paragraph(str(c).replace('|', '').replace('**', ''), SMALL_BOLD if i == 0 else SMALL)
+                              for i, c in enumerate(row)])
+             t = Table(data, colWidths=None, repeatRows=1)
