+         pending = []
+     # Check stuck tasks
+         resp = requests.get(f"{api_url}/api/tasks/list", headers=headers, timeout=10)
+         all_tasks = resp.json().get("tasks", [])
+         now_ms = time.time() * 1000
+         stuck = []
+         stuck = []
