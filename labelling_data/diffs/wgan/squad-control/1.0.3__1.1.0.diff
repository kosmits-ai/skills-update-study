+             if t.get("status") == "working" and t.get("deliverables"):
+                 started_at = t.get("startedAt")
+                 picked_up_at = t.get("pickedUpAt")
+                 is_stuck = False
+                 if not picked_up_at:
+                     is_stuck = True
+                     is_stuck = True
+                 elif started_at and (now_ms - started_at > 1800000): # 30 mins
+                 if is_stuck:
+                     stuck.append(t)
+         print(f"Error checking stuck tasks for {ws_id}: {e}")
+     return {
+         "workspace": ws,
+         "pending": pending,
+         "stuck": stuck
+     }
+ def main():
+     workspaces = get_workspaces()
+     results = []
+     for ws in workspaces:
+         res = check_workspace(ws)
+         if res and (res["pending"] or res["stuck"]):
