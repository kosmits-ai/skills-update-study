+ #!/bin/bash
+ # Check build status for a PR before merging
+ # Usage: check-build-status.sh <workspace_id> <pr_number>
+ # Exit codes: 0=success (merge ok), 1=failure, 2=pending, 3=error
+ # Output: status string (success|failure|pending|skip|error)
+ SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ source "$SCRIPT_DIR/workspace-utils.sh"
+ WS_ID="$1"
+ PR_NUMBER="$2"
+ if [ -z "$WS_ID" ] || [ -z "$PR_NUMBER" ]; then
+   echo "error"
+   echo "Usage: check-build-status.sh <workspace_id> <pr_number>" >&2
+   exit 3
+ fi
+ BUILD_CHECK=$(get_build_check_type "$WS_ID")
+ GITHUB_REPO=$(get_github_repo "$WS_ID")
+ TOKEN=$(cat /root/.git-credentials | grep github | head -1 | sed 's|https://[^:]*:\([^@]*\)@.*|\1|')
+ case "$BUILD_CHECK" in
+   vercel)
+     # Get PR head SHA
+     HEAD_SHA=$(curl -s -H "Authorization: token $TOKEN" \
+     HEAD_SHA=$(curl -s -H "Authorization: token $TOKEN" \
+       "https://api.github.com/repos/$GITHUB_REPO/pulls/$PR_NUMBER" | jq -r '.head.sha')
+       "https://api.github.com/repos/$GITHUB_REPO/pulls/$PR_NUMBER" | jq -r '.head.sha')
+     if [ -z "$HEAD_SHA" ] || [ "$HEAD_SHA" = "null" ]; then
+     if [ -z "$HEAD_SHA" ] || [ "$HEAD_SHA" = "null" ]; then
+       echo "error"
+       echo "error"
+       exit 3
+       exit 3
+     fi
+     fi
+     # Check Vercel deployment status (statuses endpoint returns array or object with .statuses)
+     STATUS=$(curl -s -H "Authorization: token $TOKEN" \
+     STATUS=$(curl -s -H "Authorization: token $TOKEN" \
+       "https://api.github.com/repos/$GITHUB_REPO/commits/$HEAD_SHA/status" | \
+       jq -r '[.statuses[]? | select(.context | contains("vercel"))] | .[0].state // "pending"')
+     case "$STATUS" in
+     case "$STATUS" in
+       success)
+         echo "success"
+         exit 0
+         ;;
+         ;;
+         ;;
+       failure|error)
+         echo "failure"
+         exit 1
+       pending|null)
+         echo "pending"
+         exit 2
+     esac
+     esac
+     ;;
+     ;;
+     ;;
+     ;;
+     ;;
+   github-actions)
+     # Check GitHub Actions status (for future use)
+       "https://api.github.com/repos/$GITHUB_REPO/commits/$HEAD_SHA/check-runs" | \
+       jq -r 'if (.check_runs | length) == 0 then "pending"
+               elif (.check_runs | all(.conclusion == "success")) then "success"
+               elif (.check_runs | any(.conclusion == "failure")) then "failure"
+               elif (.check_runs | any(.status == "in_progress" or .status == "queued")) then "pending"
+               else "pending" end')
+       success) echo "success"; exit 0 ;;
+       failure) echo "failure"; exit 1 ;;
+       *) echo "pending"; exit 2 ;;
+   firebase)
+     # Firebase: no pre-merge CI check — deploy is the verification
+     # Exit code based on deploy command result (handled by caller)
+     echo "skip"
+     echo "skip"
+     exit 0
+     exit 0
+   none|skip|"")
+   *)
+     echo "error"
+     echo "Unknown build check type: $BUILD_CHECK" >&2
+     exit 3
+ esac

