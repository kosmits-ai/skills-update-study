+ #!/bin/bash
+ # Check for tasks in review status that need Hawk's review
+ # Usage: check-reviews.sh [workspace_id]
+ # If workspace_id provided, reads config from workspace registry
+ # Otherwise falls back to hardcoded Squad Control defaults
+ SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ source "$SCRIPT_DIR/workspace-utils.sh"
+ WS_ID="${1:-squad-control}"
+ API=$(get_api_url "$WS_ID")
+ KEY=$(get_api_key "$WS_ID")
+ # Get review tasks
+ REVIEW_TASKS=$(curl -s "$API/api/tasks/list?status=review" -H "x-api-key: $KEY")
+ # Filter: has PR deliverable, reviewIteration is 0 or null (not yet reviewed),
+ # AND pickedUpAt is null (not already being worked on by Hawk)
+ echo "$REVIEW_TASKS" | jq '[.tasks[] | select(
+   (.deliverables // [] | map(select(.type == "pr")) | length > 0) and
+   ((.reviewIteration // 0) == 0) and
+   (.pickedUpAt == null)
+ ) | {
+   taskId: ._id,
+   title,
+   prUrl: (.deliverables[] | select(.type == "pr") | .url),
+   prNumber: (.deliverables[] | select(.type == "pr") | .url | split("/") | last),
+   assignedAgentId
+ }]'

