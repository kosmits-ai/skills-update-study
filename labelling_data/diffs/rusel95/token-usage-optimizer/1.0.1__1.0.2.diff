change_type: code   changelog: Fixed auto-refresh on Linux: now uses Claude CLI for reliable OAuth token refresh. No more manual updates needed!

### scripts/auto-refresh-cron.sh  [code]
- # Auto-refresh Claude Code OAuth token every 5 hours
- if [ ! -f "$TOKEN_FILE" ]; then
-   echo "ERROR: No tokens configured" >&2
-   exit 1
- source "$TOKEN_FILE"
- if [ -z "$REFRESH_TOKEN" ]; then
-   echo "ERROR: No refresh token found" >&2
- # Try multiple potential endpoints
- for endpoint in \
-   "https://api.anthropic.com/v1/oauth/refresh" \
-   "https://api.anthropic.com/oauth/refresh" \
-   "https://platform.claude.com/oauth/refresh"; do
-   echo "Trying: $endpoint"
-   REFRESH_RESP=$(curl -sf -X POST "$endpoint" \
-     -H "Content-Type: application/json" \
-     -d "{\"grant_type\":\"refresh_token\",\"refresh_token\":\"$REFRESH_TOKEN\"}" 2>&1)
-   # Extract new token
-   NEW_ACCESS=$(echo "$REFRESH_RESP" | grep -o '"access_token":"[^"]*"' | sed 's/"access_token":"//;s/"//')
-   NEW_REFRESH=$(echo "$REFRESH_RESP" | grep -o '"refresh_token":"[^"]*"' | sed 's/"refresh_token":"//;s/"//')
-   if [ -n "$NEW_ACCESS" ]; then
-     echo "✅ Token refreshed successfully!"
-     # Update tokens in file
-     sed -i.bak "s|ACCESS_TOKEN=.*|ACCESS_TOKEN=\"$NEW_ACCESS\"|" "$TOKEN_FILE"
-     # Update refresh token if new one provided
-     if [ -n "$NEW_REFRESH" ]; then
-       sed -i.bak "s|REFRESH_TOKEN=.*|REFRESH_TOKEN=\"$NEW_REFRESH\"|" "$TOKEN_FILE"
-     echo "📝 Updated tokens in $TOKEN_FILE"
-     exit 0
- done
- echo "⚠️  All refresh endpoints failed."
- echo "📋 Manual refresh needed: run 'claude auth login' and update .tokens"
+ # Auto-refresh Claude Code OAuth token using Claude CLI
+ # Check if claude CLI is available
+ if ! command -v claude >/dev/null 2>&1; then
+   echo "⚠️  Claude CLI not found. Install it or run manual refresh." >&2
+ # Trigger a simple query to force token refresh if needed
+ # Claude CLI automatically refreshes expired tokens
+ echo "ping" | claude --quiet >/dev/null 2>&1
+ # Check if refresh was successful
+ if [ -f ~/.claude/.credentials.json ]; then
+   # Extract fresh tokens
+   NEW_ACCESS=$(python3 -c "import json; d=json.load(open('$HOME/.claude/.credentials.json')); print(d.get('claudeAiOauth', {}).get('accessToken', ''))" 2>/dev/null)
+   NEW_REFRESH=$(python3 -c "import json; d=json.load(open('$HOME/.claude/.credentials.json')); print(d.get('claudeAiOauth', {}).get('refreshToken', ''))" 2>/dev/null)
+   if [ -n "$NEW_ACCESS" ] && [ -n "$NEW_REFRESH" ]; then
+     # Update .tokens file for consistency
+     if [ -f "$TOKEN_FILE" ]; then
+       cat > "$TOKEN_FILE" <<EOF
+ # Claude Code OAuth Tokens
+ # Auto-refreshed: $(date -u +"%Y-%m-%d %H:%M UTC")
+ ACCESS_TOKEN="$NEW_ACCESS"
+ REFRESH_TOKEN="$NEW_REFRESH"
+ EOF
+       chmod 600 "$TOKEN_FILE"
+       echo "✅ Token refreshed successfully via Claude CLI!"
+       echo "📝 Updated $TOKEN_FILE"
+       exit 0
+ echo "⚠️  Token refresh failed or Claude CLI not authenticated."
+ echo "📋 Run: claude auth login"

