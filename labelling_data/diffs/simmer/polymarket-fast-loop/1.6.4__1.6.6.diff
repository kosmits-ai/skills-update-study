+         with patch.object(ft, "get_client", return_value=mock_client):
+         with patch.object(ft, "get_client", return_value=mock_client):
+         with patch.object(ft, "get_client", return_value=mock_client):
+         with patch.object(ft, "get_client", return_value=mock_client):
