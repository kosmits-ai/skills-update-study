+ Claw Stack Manager v4 — safe operations via one-shot redeployer containers.
+ import json, os, urllib.request, sys
+ EP = int(os.environ.get("PORTAINER_ENDPOINT", "2"))
+ STACK_ID = int(os.environ.get("CLAW_STACK_ID", "89"))
+ def api(method, path, data=None, timeout=30, raw=False):
+     if data is not None: req.data = json.dumps(data).encode()
+         if raw: return resp.status, resp.read()
+     status, body = api("POST", f"/endpoints/{EP}/docker/images/create?fromImage={IMAGE}", timeout=600, raw=True)
+     if status in (200, 201):
+         log("✅ Image pulled")
+     log(f"❌ Pull failed (HTTP {status})")
+     return False
+ def create_redeployer():
+     """Create a one-shot container that stops → waits → starts the claw stack."""
+     script = (
+         'apk add -q curl\n'
+         f'echo "R: Stopping stack {STACK_ID}..."\n'
+         f'curl -sS -X POST -H "X-API-Key: {KEY}" '
+         f'curl -sS -X POST -H "X-API-Key: {KEY}" '
+         f'{HOST}/api/stacks/{STACK_ID}/stop?endpointId={EP}\n'
+         f'echo ""\n'
+         f'echo ""\n'
+         f'echo "R: Waiting 10s..."\n'
+         f'sleep 10\n'
+         f'echo "R: Starting stack {STACK_ID}..."\n'
+         f'{HOST}/api/stacks/{STACK_ID}/start?endpointId={EP}\n'
+         f'echo "R: Done!"\n'
+     config = {
+         "Image": "alpine:latest",
+         "Cmd": ["/bin/sh", "-c", script.strip()],
+         "HostConfig": {"NetworkMode": "host"},
+         "Labels": {"io.portainer.stack.name": "claw-redeployer"}
+     }
+     log("Creating one-shot redeployer container...")
+     status, result = api("POST",
+         f"/endpoints/{EP}/docker/containers/create?name=claw-redeployer",
+         data=config, timeout=30)
+     if status not in (200, 201, 204):
+         log(f"❌ Create failed: {result.get('error', str(result)[:200])}")
+         return False
+     cid = result.get("Id", "")
+     if not cid:
+         log("❌ No container ID returned")
+     log(f"Redeployer container: {cid[:20]}...")
+     log("Starting redeployer...")
+     s, _ = api("POST", f"/endpoints/{EP}/docker/containers/{cid}/start", timeout=10)
+     if s in (200, 204):
+     if s in (200, 204):
+         log("✅ Redeployer running (stack will restart shortly)")
+         log("   Container exits after completion, no resource leak")
+     else:
+         log(f"❌ Start failed: HTTP {s}")
+     s, containers = api("GET",
+         f"/endpoints/{EP}/docker/containers/json?filters=%7B%22name%22:%5B%22openclaw-gateway%22%5D%7D")
+     log(f"Restarting {cid[:20]}...")
+     s, _ = api("POST", f"/endpoints/{EP}/docker/containers/{cid}/restart", timeout=30)
+         log("✅ Restarted (~10s)")
+     log(f"❌ HTTP {s}")
+     print(f"  Claw Stack Manager v4 — mode: {args.mode}")
+     print(f"  One-shot redeployer, no persistent resources")
+             create_redeployer()