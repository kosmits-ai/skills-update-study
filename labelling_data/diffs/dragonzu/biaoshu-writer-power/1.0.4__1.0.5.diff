+     log_fn,
+     force=False,
+     verbose=False,
+ ):
+     """Check latest skill version once per day; never block the command."""
+         if not os.path.exists(creds_path_fn()):
+             if verbose:
+             if verbose:
+             if verbose:
+                 log_fn("未配置 Api Key，无法检查版本更新。")
