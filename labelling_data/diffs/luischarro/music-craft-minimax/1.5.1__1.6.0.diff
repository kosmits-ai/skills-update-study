+ @dataclass(frozen=True)
+ @dataclass(frozen=True)
+ class MMXReceipt:
+     command_run: list[str]
+     command_run: list[str]
+     output_path: Path | None
+     stdout: str
+     stdout: str
+     stderr: str
+     stderr: str
+     returncode: int
+     returncode: int
+     elapsed_seconds: float
+     elapsed_seconds: float
