+     release_threshold: 1.0
+     release_threshold: 1.0
+     release_threshold: 1.0
+     release_threshold: 1.0
+     release_threshold: 1.0
+     release_threshold: 1.0
+   skill_trigger_precision:
+     formula: correctly invoked requirement tasks / all skill invocations
+   first_response_value_rate:
+     formula: trials whose first response provides a useful result before asking / all trials
+   time_to_first_usable_result_seconds:
+     formula: seconds from request receipt to the first user-usable decision, specification slice or prototype change
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     direction: lower_is_better
+     release_threshold: baseline_relative
+     release_threshold: baseline_relative
+     release_threshold: baseline_relative
+     release_threshold: baseline_relative
+     release_threshold: baseline_relative
+     release_threshold: baseline_relative
+   clarification_decision_turns:
+     formula: assistant clarification turns before the target direction is decided
+     release_threshold: clear_at_most_1_ambiguous_at_most_2_high_risk_at_most_4
+   unnecessary_stage_rate:
+     formula: executed workstations not required by the explicit target / all executed workstations
+     release_threshold: 0.0
+     release_threshold: 0.0
+     release_threshold: 0.0
+     release_threshold: 0.0
+   overinterpretation_rate:
+     formula: unsupported scope, redesign or governance additions / delivered decisions and behaviors
+   visual_lock_consistency_rate:
+     formula: sampled pages matching the frozen tokens, shell, density and component variants / sampled pages
+   gate_root_cause_coverage_rate:
+     formula: unique finding codes shown in default concise diagnostics / all unique finding codes
+   gate_diagnostic_compaction_ratio:
+     formula: total findings / root-cause groups shown in the default concise diagnostics
+   gate_repair_cycles:
+     formula: gate executions from first failure to passing target milestone
+   task_satisfaction_rate:
+     formula: real users rating the result satisfied or very satisfied / users providing a rating
+   contract_adherence_rate:
+     formula: satisfied obligation weight / total executed obligation weight
+     release_threshold: 0.95
+   p0_contract_adherence_rate:
+     formula: satisfied P0 obligation weight / total executed P0 obligation weight
+   unsupported_invention_rate:
+     formula: unsupported business behaviors / delivered business behaviors
+   context_loss_rate:
+     formula: missing or conflict obligation weight / total executed obligation weight
+     release_threshold: 0.05
+     release_threshold: 0.05
+   change_regression_rate:
+     formula: failed impacted acceptance / impacted acceptance
+   spec_rework_rate:
+     formula: slices reopened for specification mismatch / delivered slices
+   tokens_per_accepted_ac:
+     formula: input plus output tokens / accepted acceptance paths
+   human_navigation_seconds:
+     formula: measured time for an intended reader to find the required behavior
+   unknown_contract_completeness_rate:
+     formula: prototype unknowns with priority, owner, blocks_stage, affected_refs and fallback / all prototype unknowns
+     release_threshold: 1.0_at_review_or_later
+   evidence_claim_honesty_rate:
+     formula: public and delivery conclusions whose claim level does not exceed their cited evidence level / all sampled conclusions
+ release_requirements:
+   minimum_repetitions: 3
+   required_stages: [requirement, design, coding_delivery]
+   required_shapes: [greenfield, brownfield]
+   required_experience_shapes:
+     - clear_small_requirement
+     - ambiguous_early_idea
+     - brownfield_prototype_iteration
+     - regulated_complex_requirement
+   required_experience_evidence:
+     - trigger_decision
+     - time_to_first_usable_result_seconds
+     - clarification_decision_turns
+     - unnecessary_stage_count
+     - unsupported_scope_or_redesign_count
+     - target_completion_result
+   critical_rules:
+     p0_missing: 0
+     p0_unsupported_inventions: 0
+     silent_truncation: 0
+     coding_delivery_requires_executed_slice: true
+     token_measurement_required: true

