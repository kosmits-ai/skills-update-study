+                       LINES[i % 3], PRODUCTS[(i // 3) % 3], 50 + (i * 11) % 150,
+                       3 if i % 9 == 0 else (1 if i % 13 == 0 else 0)))
+     for i in range(1, 16):
+         conn.execute("INSERT INTO equipment VALUES (?,?,?,?,?)",
+                      (f"E{i:03d}", DTYPES[i % 3], ESTATUS[(i // 2) % 3], LINES[i % 3],
