+ LINES = ["A线", "B线", "C线"]
+ PRODUCTS = ["零件甲", "零件乙", "零件丙"]
+ DTYPES = ["冲压机", "焊接机", "组装线"]
+ ESTATUS = ["运行", "停机", "检修"]
