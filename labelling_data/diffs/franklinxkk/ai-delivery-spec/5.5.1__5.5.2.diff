-     "--language", "auto", "--format", "json",
- )
- )
- if code != 2 or english.get("output_language") != "en-US":
-     failures.append(f"English auto-language gate failed: rc={code}")
- if re.search(r"[\u4e00-\u9fff]", visible_text(english)):
