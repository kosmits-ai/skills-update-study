+       echo "$NEXT_CURSOR" > "$CURSOR_FILE"
+     MESSAGE_COUNT=$(echo "$RESPONSE" | jq -r '.messages | length')
+     echo ""
+     if [[ "$MESSAGE_COUNT" -gt 0 ]]; then
+       echo "💬 Received $MESSAGE_COUNT message(s)"
