+     "(KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
+ )
+ ALLOWED_PORTS = (80, 443)
+ MAX_REDIRECTS = 3
+ DEFAULT_MAX_BYTES = 5 * 1024 * 1024  # 5 MB
+ DEFAULT_TIMEOUT = 30
+ class BlockedTargetError(RuntimeError):
+     """目标不允许访问（内网/保留地址、协议或端口不合规）。"""
+ def is_blocked_ip(ip: str) -> bool:
