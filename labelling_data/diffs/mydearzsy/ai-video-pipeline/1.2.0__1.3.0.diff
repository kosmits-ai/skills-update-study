+                     j = json.loads(pd)
+                 except:
+                     continue
+                 if evt == 360:
+                     rounds_info.append((j.get("round_id"), j.get("speaker", ""), j.get("text", ""), 0))
+                 elif evt == 362:
+                     dur = j.get("audio_duration", 0)
+                     if rounds_info:
+                         rounds_info[-1] = (*rounds_info[-1][:3], dur)
+                 elif evt == 154:
+                     total_tokens = j.get("usage", {}).get("total_tokens", 0)
+                     recv_timeout = 5
+                 elif evt == 363:
