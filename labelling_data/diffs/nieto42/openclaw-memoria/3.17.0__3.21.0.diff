+ def expand_query(query):
+     variants = [query]
+     lower = query.lower()
+     for key, synonyms in CONCEPT_MAP.items():
+         if key in lower:
+             for syn in synonyms[:2]:
+                 variant = re.sub(re.escape(key), syn, query, flags=re.IGNORECASE)
+                 if variant != query and variant not in variants:
