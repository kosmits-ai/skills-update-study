-     params: {{}} }},
- ts_code += '''];
- server.setRequestHandler(ListToolsRequestSchema, async () => ({
-   tools: tools.map(t => ({
-     name: t.name,
-     description: t.description,
-     inputSchema: { type: "object", properties: {} },
-   })),
- }));
- const endpointMap: Record<string, string> = {
- # 添加 endpoint 映射
