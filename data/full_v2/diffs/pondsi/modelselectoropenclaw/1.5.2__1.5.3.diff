+     try {
+         $npmRoot = (& npm root -g 2>$null)
+         if ($npmRoot) { $candidates.Add((Join-Path $npmRoot 'openclaw\dist\control-ui')) }
+     } catch {}
+     } catch {}
+     # 2) 常见 npm 全局前缀
+     $candidates.Add('C:\npm-global\node_modules\openclaw\dist\control-ui')
