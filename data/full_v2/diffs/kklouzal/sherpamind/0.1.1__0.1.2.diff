+             cold_pages = settings.cold_closed_pages_per_run
+             cold_pages = settings.cold_closed_pages_per_run
+             enrich_limit = settings.service_enrichment_limit
+             enrich_limit = settings.service_enrichment_limit
+             allow_deferrable = spare >= 40
+     else:
