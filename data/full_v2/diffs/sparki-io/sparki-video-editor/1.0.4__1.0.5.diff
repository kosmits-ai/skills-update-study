### scripts/setup.sh  [code]
- #!/usr/bin/env bash
- set -euo pipefail
- SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
- PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
- cd "$PROJECT_DIR"
- if ! command -v uv &>/dev/null; then
-     echo '{"ok": false, "data": null, "error": {"code": "MISSING_UV", "message": "uv is not installed", "action": "Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh"}}' >&2
-     exit 1
- fi
- uv sync
- echo "Sparki CLI installed successfully." >&2