### scripts/canvas_update.py  [code]
+ #!/usr/bin/env python3
+ """canvas_update.py — Append knowledge nodes to a JSON Canvas file."""
+ import argparse
+ import json
+ import os
+ import sys
+ def load_canvas(path: str) -> dict:
+     if os.path.exists(path):
+         with open(path) as f:
+             return json.load(f)
+     return {"nodes": [], "edges": []}
+ def next_position(nodes: list, grid_x: int = 300, grid_y: int = 200) -> tuple:
+     """Position new nodes in a grid below existing ones."""
+     if not nodes:
+         return (0, 0)
+     max_y = max(n.get("y", 0) + n.get("height", 100) for n in nodes)
+     # Find rightmost node at the bottom row
+     bottom_nodes = [n for n in nodes if n.get("y", 0) + n.get("height", 100) >= max_y - 10]
+     max_x = max(n.get("x", 0) + n.get("width", 260) for n in bottom_nodes) if bottom_nodes else 0
+     if max_x + 260 > 1200:  # wrap to next row
+         return (0, max_y + 40)
+     return (max_x + 40, bottom_nodes[0].get("y", 0) if bottom_nodes else 0)
+ def main():
+     parser = argparse.ArgumentParser()
+     parser.add_argument("--input", required=True, help="JSONL file with note objects")
+     parser.add_argument("--canvas", required=True, help="Path to canvas JSON file")
+     args = parser.parse_args()
+     canvas = load_canvas(args.canvas)
+     existing_ids = {n["id"] for n in canvas["nodes"]}
+     node_counter = len(canvas["nodes"]) + 1
+     with open(args.input) as f:
+         for line in f:
+             line = line.strip()
+             if not line:
+                 continue
+                 continue
+             note = json.loads(line)
+             nid = f"share-{note['id']}"
+             if nid in existing_ids:
+             x, y = next_position(canvas["nodes"])
+             text = f"**{note['title']}**\n{note['text'][:300]}"
+             node = {
+                 "id": nid,
+                 "type": "text",
+                 "text": text,
+                 "x": x,
+                 "y": y,
+                 "width": 260,
+                 "height": 160,
+                 "color": "4",
+             }
+             canvas["nodes"].append(node)
+             node_counter += 1
+     os.makedirs(os.path.dirname(args.canvas) or ".", exist_ok=True)
+     with open(args.canvas, "w") as f:
+         json.dump(canvas, f, indent=2, ensure_ascii=False)
+     print(f"Updated {args.canvas} with {node_counter - len(existing_ids) - 1} new nodes")
+ if __name__ == "__main__":
+     main()

