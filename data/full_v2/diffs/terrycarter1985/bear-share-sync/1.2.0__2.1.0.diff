### scripts/notify.sh  [code]
+ #!/usr/bin/env bash
+ # notify.sh — Send note previews via BlueBubbles
+ set -euo pipefail
+ SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+ source "${SCRIPT_DIR}/config.sh"
+ if [ -z "$BB_TARGET" ]; then
+   echo "WARNING: BB_TARGET not set, skipping notifications" >&2
+   exit 0
+ fi
+ fi
+ fi
+ INPUT_FILE="${1:-}"
+ if [ -z "$INPUT_FILE" ] && [ ! -t 0 ]; then
+   INPUT_FILE="/tmp/bear-share-notify-$$.jsonl"
+   cat > "$INPUT_FILE"
+   trap 'rm -f "$INPUT_FILE"' EXIT
+ if [ -z "$INPUT_FILE" ]; then
+   echo "Usage: notify.sh --input FILE" >&2
+   exit 1
+ # Parse --input flag
+ while [[ $# -gt 0 ]]; do
+   case $1 in
+     --input) INPUT_FILE="$2"; shift 2 ;;
+     *) shift ;;
+   esac
+ done
+ done
+ python3 -c "
+ import json, sys, subprocess
+ target = '$BB_TARGET'
+ with open('$INPUT_FILE') as f:
+     for line in f:
+         line = line.strip()
+         if not line: continue
+         note = json.loads(line)
+         title = note.get('title', 'Untitled')
+         text = note.get('text', '')[:200]
+         msg = f'📝 New shared note: \"{title}\"\n{text}'
+         # Output the message for the caller to send via OpenClaw message tool
+         print(json.dumps({'target': target, 'message': msg}, ensure_ascii=False))
+ " | while IFS= read -r payload; do
+   # This script outputs payloads; actual sending is done by the OpenClaw agent
+   echo "NOTIFY_PAYLOAD: $payload"

### scripts/poll.sh  [code]
+ #!/usr/bin/env bash
+ # poll.sh — Find new Bear notes tagged #share not yet processed
+ set -euo pipefail
+ SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+ # shellcheck source=config.sh
+ source "${SCRIPT_DIR}/config.sh"
+ STATE_DIR="$(dirname "$STATE_FILE")"
+ mkdir -p "$STATE_DIR"
+ # Initialize state file
+ if [ ! -f "$STATE_FILE" ]; then
+   echo '{"seen":[]}' > "$STATE_FILE"
+ fi
+ # Fetch notes with the share tag
+ NOTES_JSON=$(grizzly open-tag --name "$SHARE_TAG" --enable-callback --json 2>/dev/null || echo '{"notes":[]}')
+ # Extract note IDs we've already seen
+ SEEN_IDS=$(python3 -c "
+ import json,sys
+ state=json.load(open('$STATE_FILE'))
+ print(' '.join(state.get('seen',[])))
+ ")
+ # Filter and output new notes
+ python3 -c "
+ import json, sys
+ notes_json = json.loads('''$NOTES_JSON''')
+ seen = set('''$SEEN_IDS'''.split()) if '$SEEN_IDS'.strip() else set()
+ notes = notes_json.get('notes', []) if isinstance(notes_json, dict) else notes_json
+ new_ids = []
+ for note in notes:
+     nid = note.get('identifier', note.get('id', ''))
+     if nid and nid not in seen:
+         new_ids.append(nid)
+         output = {
+             'id': nid,
+             'title': note.get('title', ''),
+             'text': note.get('text', note.get('content', ''))[:500],
+             'created': note.get('creationDate', note.get('created', ''))
+         }
+         print(json.dumps(output, ensure_ascii=False))
+ # Update state
+ if new_ids:
+     state = json.load(open('$STATE_FILE'))
+     state['seen'].extend(new_ids)
+     json.dump(state, open('$STATE_FILE','w'))
+ " "$@"

### scripts/sync.sh  [code]
- #!/usr/bin/env bash
- set -euo pipefail
- SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
- STATE_FILE="${STATE_FILE:-$SKILL_DIR/state.json}"
- CANVAS_PATH="${CANVAS_PATH:-canvases/agent_capabilities.canvas}"
- PREVIEW_LENGTH="${PREVIEW_LENGTH:-200}"
- GROUP_CHAT_GUID="${GROUP_CHAT_GUID:?Set GROUP_CHAT_GUID env var}"
- TOKEN_FILE="${GRIZZLY_TOKEN_FILE:-$HOME/.config/grizzly/token}"
- # Initialize state file
- if [ ! -f "$STATE_FILE" ]; then
-   echo '{"processed":[]}' > "$STATE_FILE"
- fi
- # 1. Poll #share notes
- NOTES_JSON=$(grizzly open-tag --name "share" --enable-callback --json --token-file "$TOKEN_FILE" 2>/dev/null || echo '{"notes":[]}')
- # 2. Get already-processed IDs
- PROCESSED_IDS=$(jq -r '.processed[].id' "$STATE_FILE" 2>/dev/null || echo "")
- # 3. For each note, check if new
- echo "$NOTES_JSON" | jq -c '.notes[] // empty' | while read -r note; do
-   NOTE_ID=$(echo "$note" | jq -r '.id // .identifier')
-   TITLE=$(echo "$note" | jq -r '.title')
-   # Skip if already processed
-   if echo "$PROCESSED_IDS" | grep -qx "$NOTE_ID"; then
-     continue
-   fi
-   fi
-   # Read full note
-   NOTE_DETAIL=$(grizzly open-note --id "$NOTE_ID" --enable-callback --json --token-file "$TOKEN_FILE" 2>/dev/null || echo '{}')
-   BODY=$(echo "$NOTE_DETAIL" | jq -r '.text // .content // ""' | sed 's/#share//g' | sed '/^$/d' | head -20)
-   PREVIEW=$(echo "$BODY" | head -c "$PREVIEW_LENGTH")
-   CREATED=$(echo "$NOTE_DETAIL" | jq -r '.creationDate // .created_at // now' )
-   echo "Processing: $TITLE ($NOTE_ID)"
-   # 4. Update canvas
-   if [ -f "$CANVAS_PATH" ]; then
-     CANVAS_JSON=$(cat "$CANVAS_PATH")
-   else
-     CANVAS_JSON='{"nodes":[],"edges":[]}'
-   # Calculate position
-   NODE_COUNT=$(echo "$CANVAS_JSON" | jq '.nodes | length')
-   COL=$(( NODE_COUNT % 4 ))
-   ROW=$(( NODE_COUNT / 4 ))
-   X=$(( COL * 300 ))
-   Y=$(( ROW * 200 ))
-   SAFE_ID="bear-$(echo "$NOTE_ID" | tr -c 'a-zA-Z0-9_-' '-')"
-   NEW_NODE=$(jq -n \
-     --arg id "$SAFE_ID" \
-     --arg text "📝 $TITLE\n$PREVIEW\n— Bear #share" \
-     --argjson x "$X" --argjson y "$Y" \
-     '{id: $id, type: "text", text: $text, x: $x, y: $y, width: 260, height: 120, color: "4"}')
-   UPDATED_CANVAS=$(echo "$CANVAS_JSON" | jq --argjson node "$NEW_NODE" '.nodes += [$node]')
-   mkdir -p "$(dirname "$CANVAS_PATH")"
-   echo "$UPDATED_CANVAS" > "$CANVAS_PATH"
-   # 5. Send via BlueBubbles (output message for agent to send)
-   MSG="📝 New shared note: $TITLE\n\n$PREVIEW\n\n— via Bear #share"
-   echo "BLUEBUBBLES_SEND:$GROUP_CHAT_GUID:$MSG"
-   # 6. Update state
-   STATE_ENTRY=$(jq -n --arg id "$NOTE_ID" --arg title "$TITLE" --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
-     '{id: $id, title: $title, processedAt: $ts}')
-   jq --argjson entry "$STATE_ENTRY" '.processed += [$entry]' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
-   echo "Done: $TITLE"
- done
- echo "Sync complete."