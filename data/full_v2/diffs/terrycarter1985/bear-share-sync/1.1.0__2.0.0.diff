### scripts/sync_share_notes.sh  [code]
+ #!/usr/bin/env bash
+ # bear-share-sync: detect #share-tagged Bear notes, update canvas, notify via BlueBubbles
+ set -euo pipefail
+ CANVAS_FILE="${CANVAS_FILE:-agent_capabilities.canvas}"
+ STATE_FILE="${STATE_FILE:-/tmp/bear-share-sync-state.json}"
+ BEAR_TOKEN_FILE="${BEAR_TOKEN_FILE:-$HOME/.config/grizzly/token}"
+ # --- Step 1: Fetch #share notes from Bear ---
+ if ! command -v grizzly &>/dev/null; then
+   echo "ERROR: grizzly not installed" >&2; exit 1
+ fi
+ fi
+ fi
+ fi
+ share_json=$(grizzly open-tag --name "share" --enable-callback --json --token-file "$BEAR_TOKEN_FILE" 2>/dev/null || echo '{"notes":[]}')
+ # Extract note IDs we've already processed
+ if [[ -f "$STATE_FILE" ]]; then
+   processed_ids=$(jq -r '.processed_ids // [] | .[]' "$STATE_FILE" | tr '\n' ' ')
+ else
+ else
+   processed_ids=""
+ # Find new note IDs
+ new_ids=()
+ while IFS= read -r nid; do
+   if ! echo "$processed_ids" | grep -qw "$nid"; then
+     new_ids+=("$nid")
+   fi
+ done < <(echo "$share_json" | jq -r '.notes[].identifier // empty')
+ if [[ ${#new_ids[@]} -eq 0 ]]; then
+   echo "NO_NEW_NOTES"
+   exit 0
+ echo "FOUND_NEW_NOTES:${#new_ids[@]}"
+ # --- Step 2: Extract content from each new note ---
+ notes_data="[]"
+ for nid in "${new_ids[@]}"; do
+ for nid in "${new_ids[@]}"; do
+   note_json=$(grizzly open-note --id "$nid" --enable-callback --json --token-file "$BEAR_TOKEN_FILE" 2>/dev/null || continue)
+   title=$(echo "$note_json" | jq -r '.note.title // "Untitled"')
+   content=$(echo "$note_json" | jq -r '.note.text // ""' | head -c 500)
+   notes_data=$(echo "$notes_data" | jq --arg id "$nid" --arg t "$title" --arg c "$content" \
+     '. += [{"id": $id, "title": $t, "content": $c}]')
+ done
+ done
+ echo "$notes_data" > /tmp/bear-share-new-notes.json
+ # --- Step 3: Update agent_capabilities.canvas ---
+ # Find next available node position
+ if [[ -f "$CANVAS_FILE" ]]; then
+   max_x=$(jq '.nodes | map(.x) | max // 0' "$CANVAS_FILE")
+   max_id_num=$(jq '[.nodes[].id | scan("\\d+") | tonumber] | max // 0' "$CANVAS_FILE")
+   max_x=0
+   max_id_num=0
+   echo '{"nodes":[],"edges":[]}' > "$CANVAS_FILE"
+ # Add a text node for each note
+ idx=0
+ while IFS= read -r note; do
+   ((idx++)) || true
+   ((max_id_num++)) || true
+   node_id="n${max_id_num}"
+   title=$(echo "$note" | jq -r '.title')
+   content=$(echo "$note" | jq -r '.content')
+   preview="${title}"$'\n'"${content:0:120}"
+   x_pos=$((max_x + idx * 300))
+   jq --arg nid "$node_id" --arg text "$preview" --argjson x "$x_pos" \
+     '.nodes += [{"id": $nid, "type": "text", "text": $text, "x": $x, "y": 0, "width": 260, "height": 120, "color": "5"}]' \
+     "$CANVAS_FILE" > "${CANVAS_FILE}.tmp" && mv "${CANVAS_FILE}.tmp" "$CANVAS_FILE"
+ done < <(echo "$notes_data" | jq -c '.[]')
+ # --- Step 4: Update processed state ---
+   jq --arg id "$nid" '.processed_ids = ((.processed_ids // []) + [$id])' "$STATE_FILE" > "${STATE_FILE}.tmp" 2>/dev/null \
+     && mv "${STATE_FILE}.tmp" "$STATE_FILE" || echo "{\"processed_ids\":[\"$nid\"]}" > "$STATE_FILE"
+ echo "SYNC_COMPLETE"

