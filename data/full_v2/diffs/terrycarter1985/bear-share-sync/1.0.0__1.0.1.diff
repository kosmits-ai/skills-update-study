+ DRY_RUN=true CANVAS_FILE=./canvases/agent_capabilities.canvas scripts/sync_share_notes.sh

### references/canvas-schema.md  [docs]
- # JSON Canvas Node Schema for bear-share-sync
- Each synced Bear note becomes a `text` node:
- | Field     | Value                              |
- |-----------|------------------------------------|
- | `id`      | `n<incrementing>`                  |
- | `type`    | `text`                             |
- | `text`    | `**Title**\n<first 200 chars>`     |
- | `x`       | auto (300px grid, right of last)   |
- | `y`       | `0`                                |
- | `width`   | `240`                              |
- | `height`  | `120`                              |
- | `color`   | `"4"` (green)                      |
- | `bear_id` | Bear note identifier (dedup key)   |
- Edges are not created automatically. Use the canvas skill to connect nodes manually.

### references/canvas_schema.md  [docs]
+ # Canvas Schema Reference
+ ## agent_capabilities.canvas
+ The canvas file uses JSON Canvas format (Obsidian-compatible) with these conventions:
+ - **Node types**: `text` for shared knowledge capsules
+ - **Color code `"4"`** (green) for #share-sourced nodes
+ - **Auto-positioning**: new nodes placed below the lowest existing node with 40px gap
+ - **Node ID format**: `share_<sanitized_bear_note_id>` (alphanumeric + underscore only)
+ - **Text format**: `📌 <title>\n<summary excerpt>`
+ ### Example node
+ ```json
+ {
+   "id": "share_ABC123",
+   "type": "text",
+   "text": "📌 Research Methodology\nA concise summary of the note content...",
+   "x": 0,
+   "y": 240,
+   "width": 280,
+   "height": 120,
+   "color": "4"
+ }
+ ```

### scripts/sync_share_notes.sh  [code]
- # sync_share_notes.sh — Detect #share-tagged Bear notes, update canvas, send preview
- CANVAS_DIR="${CANVAS_DIR:-/root/.openclaw/workspace/canvases}"
- CANVAS_FILE="${CANVAS_DIR}/agent_capabilities.canvas"
- BB_TARGET="${BB_TARGET:-}"          # BlueBubbles target (chat_guid or phone)
- BB_CHANNEL="${BB_CHANNEL:-bluebubbles}"
- GRIZZLY="${GRIZZLY:-grizzly}"
- TOKEN_FILE="${TOKEN_FILE:-$HOME/.config/grizzly/token}"
- STATE_FILE="${STATE_FILE:-$HOME/.local/share/bear-share-sync/state.json}"
- mkdir -p "$(dirname "$STATE_FILE")" "$CANVAS_DIR"
- # --- Step 1: Fetch #share notes from Bear ---
- if ! notes_json=$($GRIZZLY open-tag --name "share" --enable-callback --json --token-file "$TOKEN_FILE" 2>/dev/null); then
-   echo "ERROR: Failed to query Bear for #share notes" >&2
-   exit 1
- fi
- fi
- fi
- fi
- fi
- fi
- # --- Step 2: Load already-processed IDs ---
- declare -A processed
- if [[ -f "$STATE_FILE" ]]; then
- if [[ -f "$STATE_FILE" ]]; then
-   while IFS= read -r id; do processed["$id"]=1; done < <(jq -r '.processed[] // empty' "$STATE_FILE")
- # --- Step 3: Extract new notes ---
- new_notes=$(echo "$notes_json" | jq -c '[.notes // .[] // . | if type == "array" then .[] else . end | select(.identifier != null)]')
- if [[ -z "$new_notes" || "$new_notes" == "[]" ]]; then
-   echo "No #share notes found."
-   exit 0
- # --- Step 4: Update canvas ---
- # Initialize canvas if missing
- if [[ ! -f "$CANVAS_FILE" ]]; then
-   echo '{"nodes":[],"edges":[]}' > "$CANVAS_FILE"
- # Find next x position
- next_x=$(jq '[.nodes[].x // 0] | max // 0 | . + 300' "$CANVAS_FILE")
- next_id=$(jq '.nodes | length' "$CANVAS_FILE")
- updated_canvas=$(echo "$new_notes" | jq --argjson base_x "$next_x" --argjson base_id "$next_id" --slurpfile canvas "$CANVAS_FILE" '
-   $canvas[0] as $c |
-   [to_entries[] |
-     select((.value.identifier // .value.id // (.key | tostring)) as $nid |
-       ($c.nodes | map(.bear_id // "") | index($nid) | not)) |
-     {
-       id: ("n\($base_id + .key)"),
-       type: "text",
-       text: "**\(.value.title // "Untitled")**\n\(.value.text[:200])",
-       x: ($base_x + (.key * 260)),
-       y: 0,
-       width: 240,
-       height: 120,
-       color: "4",
-       bear_id: (.value.identifier // .value.id // (.key | tostring))
-     }
-   ] as $new_nodes |
-   $c | .nodes += $new_nodes
- ')
- echo "$updated_canvas" > "$CANVAS_FILE"
- # --- Step 5: Build preview text & send via BlueBubbles ---
- new_count=$(echo "$new_notes" | jq 'length')
- if [[ "$new_count" -eq 0 ]]; then
-   echo "No new #share notes to distribute."
- preview=$(echo "$new_notes" | jq -r '
-   to_entries[] | "📌 \(.value.title // "Untitled")\n\(.value.text[:150])…\n"
- ' | head -20)
- echo "--- Preview ---"
- echo "$preview"
- if [[ -n "$BB_TARGET" ]]; then
-   echo "Sending preview to $BB_TARGET via $BB_CHANNEL..."
-   # The actual send is delegated to the message tool in the agent turn
-   echo "BB_SEND_REQUIRED=1"
-   echo "BB_MESSAGE=$preview"
- # --- Step 6: Update state ---
- processed_ids=$(echo "$new_notes" | jq -c '[.[].identifier // .[].id // []] | flatten')
-   jq --argjson new "$processed_ids" '.processed += $new | .processed |= unique' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
- else
-   echo "{\"processed\":$processed_ids}" > "$STATE_FILE"
- echo "Synced $new_count new note(s) to canvas."
+ # bear-share-sync: detect #share notes, update canvas, send preview
+ CANVAS_FILE="${CANVAS_FILE:-agent_capabilities.canvas}"
+ BLUEBUBBLES_TARGET="${BLUEBUBBLES_TARGET:-}"  # E.164 or chat_guid
+ BEAR_TOKEN_FILE="${BEAR_TOKEN_FILE:-$HOME/.config/grizzly/token}"
+ DRY_RUN="${DRY_RUN:-false}"
+ STATE_FILE="${STATE_FILE:-$HOME/.config/bear-share-sync/seen_ids.txt}"
+ mkdir -p "$(dirname "$STATE_FILE")"
+ # 1. Fetch #share notes from Bear
+ echo "🔍 Scanning Bear for #share notes..."
+ notes_json=$(grizzly open-tag --name "share" --enable-callback --json --token-file "$BEAR_TOKEN_FILE" 2>/dev/null || echo '{"notes":[]}')
+ # 2. Extract new note IDs
+ new_ids=()
+ while IFS= read -r nid; do
+   if ! grep -qx "$nid" "$STATE_FILE" 2>/dev/null; then
+     new_ids+=("$nid")
+   fi
+   fi
+   fi
+ done < <(echo "$notes_json" | jq -r '.notes[].identifier // empty')
+ if [ ${#new_ids[@]} -eq 0 ]; then
+   echo "✅ No new #share notes."
+ echo "📝 Found ${#new_ids[@]} new note(s)."
+ # 3. Process each new note
+ for nid in "${new_ids[@]}"; do
+   note_detail=$(grizzly open-note --id "$nid" --enable-callback --json --token-file "$BEAR_TOKEN_FILE" 2>/dev/null || continue)
+   title=$(echo "$note_detail" | jq -r '.note.title // "Untitled"')
+   body=$(echo "$note_detail" | jq -r '.note.text // ""' | head -c 2000)
+   echo "   Processing: $title"
+   # 4. Generate canvas node entry (append to JSON)
+   node_id="share_$(echo "$nid" | tr -c 'a-zA-Z0-9_' '_')"
+   summary=$(echo "$body" | head -c 300 | jq -Rs .)
+   node_json=$(jq -n \
+     --arg id "$node_id" \
+     --arg title "$title" \
+     --argjson summary "$summary" \
+     '{id: $id, type: "text", text: "📌 \($title)\n\($summary)", x: 0, y: 0, width: 280, height: 120, color: "4"}')
+   # 5. Update canvas file
+   if [ -f "$CANVAS_FILE" ]; then
+     # Auto-position: place below lowest existing node
+     max_y=$(jq '[.nodes[].y + .nodes[].height] | max // 0' "$CANVAS_FILE")
+     node_json=$(echo "$node_json" | jq --argjson y "$max_y" '.y = ($y + 40)')
+     jq --argjson node "$node_json" '.nodes += [$node]' "$CANVAS_FILE" > "${CANVAS_FILE}.tmp" && mv "${CANVAS_FILE}.tmp" "$CANVAS_FILE"
+   else
+   else
+     echo "{\"nodes\":[$node_json],\"edges\":[]}" | jq . > "$CANVAS_FILE"
+   echo "   🗺️  Canvas node added: $node_id"
+   # 6. Send preview via BlueBubbles (if target set and not dry-run)
+   if [ -n "$BLUEBUBBLES_TARGET" ] && [ "$DRY_RUN" != "true" ]; then
+     preview="📢 New shared note: $title\n\n$(echo "$body" | head -c 500)"
+     # Actual send is delegated to the OpenClaw message tool; this script just logs intent
+     echo "   📤 Would send preview to $BLUEBUBBLES_TARGET"
+     echo "$BLUEBUBBLES_TARGET" > /tmp/bear_share_last_target
+     echo "$preview" > /tmp/bear_share_last_preview
+     echo "   ℹ️  Preview skipped (no target or dry-run)"
+   # 7. Mark as seen
+   echo "$nid" >> "$STATE_FILE"
+ done
+ echo "✅ Sync complete. ${#new_ids[@]} note(s) processed."