+ #!/usr/bin/env python3
+ """update_canvas.py — Append JSON Canvas nodes from extracted notes into agent_capabilities.canvas"""
+ import json
+ import sys
+ import os
+ from pathlib import Path
+ CANVAS_PATH = os.environ.get(
+     "BEAR_SHARE_CANVAS",
+     str(Path.home() / ".openclaw" / "workspace" / "canvases" / "agent_capabilities.canvas"),
+ )
+ def load_canvas(path: str) -> dict:
+     p = Path(path)
+     p = Path(path)
+     if p.exists():
+         return json.loads(p.read_text())
+     return {"nodes": [], "edges": []}
+ def save_canvas(path: str, data: dict):
+     Path(path).parent.mkdir(parents=True, exist_ok=True)
+     p.write_text(json.dumps(data, indent=2, ensure_ascii=False))
+ def next_id(nodes: list, prefix: str = "n") -> str:
+     existing = {n["id"] for n in nodes}
+     i = len(nodes) + 1
+     while f"{prefix}{i}" in existing:
+         i += 1
+     return f"{prefix}{i}"
+ def main():
+     canvas = load_canvas(CANVAS_PATH)
+     existing_ids = {n.get("bear_note_id") for n in canvas["nodes"] if "bear_note_id" in n}
+     for line in sys.stdin:
+         line = line.strip()
+         if not line:
+             continue
+             continue
+         note = json.loads(line)
+         nid = note["id"]
+         if nid in existing_ids:
+         # Layout: place new nodes to the right of existing rightmost node
+         max_x = max((n.get("x", 0) + n.get("width", 0) for n in canvas["nodes"]), default=0)
+         x = max_x + 60
+         y = len(canvas["nodes"]) * 20  # slight stagger
+         # Truncate content for canvas display
+         preview = note["content"][:200].replace("\n", " ")
+         if len(note["content"]) > 200:
+             preview += "…"
+         node = {
+             "id": next_id(canvas["nodes"]),
+             "type": "text",
+             "x": x,
+             "y": y,
+             "width": 260,
+             "height": 120,
+             "color": "5",  # cyan
+             "text": f"**{note['title']}**\n{preview}",
+             "bear_note_id": nid,
+         }
+         canvas["nodes"].append(node)
+     save_canvas(CANVAS_PATH, canvas)
+     print(f"Canvas updated: {CANVAS_PATH}")
+ if __name__ == "__main__":
+     main()