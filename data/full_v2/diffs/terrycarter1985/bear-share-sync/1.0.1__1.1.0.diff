### scripts/detect_and_extract.sh  [code]
+ #!/usr/bin/env bash
+ # detect_and_extract.sh — Fetch Bear notes tagged #share not yet processed
+ # Output: JSONL, one line per new note: {"id","title","content","created"}
+ set -euo pipefail
+ STATE_FILE="${BEAR_SHARE_STATE:-$HOME/.cache/bear-share-sync/processed_ids.json}"
+ CANVAS_FILE="${BEAR_SHARE_CANVAS:-}"
+ DISTRIBUTE_TARGET="${BLUEBUBBLES_TARGET:-}"
+ mkdir -p "$(dirname "$STATE_FILE")"
+ # Load previously seen IDs
+ declare -A SEEN
+ if [[ -f "$STATE_FILE" ]]; then
+   while IFS= read -r sid; do SEEN["$sid"]=1; done < <(jq -r '.[]' "$STATE_FILE" 2>/dev/null)
+ fi
+ fi
+ # Fetch all notes with #share tag
+ RAW=$(grizzly open-tag --name "share" --enable-callback --json --token-file ~/.config/grizzly/token 2>/dev/null || echo '{"notes":[]}')
+ NEW_IDS=()
+ while IFS= read -r note; do
+   ID=$(echo "$note" | jq -r '.identifier // .id')
+   if [[ -z "${SEEN[$ID]+x}" ]]; then
+     # Fetch full note content
+     DETAIL=$(grizzly open-note --id "$ID" --enable-callback --json 2>/dev/null || echo '{}')
+     TITLE=$(echo "$DETAIL" | jq -r '.title // "Untitled"')
+     CONTENT=$(echo "$DETAIL" | jq -r '.text // ""')
+     CREATED=$(echo "$DETAIL" | jq -r '.creationDate // .created // ""')
+     # Strip #share tag from content for clean extraction
+     CLEAN_CONTENT=$(echo "$CONTENT" | sed '/^#share$/d' | sed 's/#share//' | sed '/^$/N;/^\n$/D')
+     # Output JSONL
+     jq -n --arg id "$ID" --arg title "$TITLE" --arg content "$CLEAN_CONTENT" --arg created "$CREATED" \
+       '{id:$id, title:$title, content:$content, created:$created}'
+     NEW_IDS+=("$ID")
+   fi
+ done < <(echo "$RAW" | jq -c '.notes[] // empty')
+ # Update state file with newly processed IDs
+ if [[ ${#NEW_IDS[@]} -gt 0 ]]; then
+   for nid in "${NEW_IDS[@]}"; do
+     echo "$nid"
+   done | jq -R . | jq -s '.' >> "$STATE_FILE" 2>/dev/null || true
+   # Deduplicate state
+   jq -s 'unique' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"

### scripts/distribute.py  [code]
+ #!/usr/bin/env python3
+ """distribute.py — Format note preview and output a message payload for BlueBubbles delivery"""
+ import json
+ import sys
+ def main():
+     messages = []
+     for line in sys.stdin:
+         line = line.strip()
+         if not line:
+             continue
+         note = json.loads(line)
+         preview = note["content"][:300]
+         if len(note["content"]) > 300:
+             preview += "…"
+         msg = f"📝 Shared Note: {note['title']}\n\n{preview}\n\n— via Bear #share sync"
+         messages.append({"target": note.get("target", ""), "message": msg})
+     # Output as JSON for the skill runner to consume
+     print(json.dumps(messages, ensure_ascii=False))
+ if __name__ == "__main__":
+     main()

