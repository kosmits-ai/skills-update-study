+ // Douyin search with captcha solving via CDP
+ const { chromium } = require('playwright');
+ (async () => {
+   const keyword = process.argv[2] || '海鲜';
+   const browser = await chromium.launch({
+     headless: true,
+     executablePath: '/usr/bin/chromium',
+     args: ['--disable-blink-features=AutomationControlled', '--no-sandbox', '--disable-dev-shm-usage']
+   });
+   });
+   });
+   const context = await browser.newContext({
+     userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36',
+     viewport: { width: 1920, height: 1080 },
+     locale: 'zh-CN',
+   await context.addInitScript(() => {
+     Object.defineProperty(navigator, 'webdriver', { get: () => false });
+     Object.defineProperty(navigator, 'plugins', { get: () => [1, 2, 3, 4, 5] });
+     Object.defineProperty(navigator, 'languages', { get: () => ['zh-CN', 'zh', 'en'] });
+     window.chrome = { runtime: {} };
+   const page = await context.newPage();
+   try {
+     // First visit /hot to establish session
+     await page.goto('https://www.douyin.com/hot', { waitUntil: 'domcontentloaded', timeout: 15000 });
+     await page.waitForTimeout(3000);
+     await page.waitForTimeout(3000);
+     await page.waitForTimeout(3000);
+     console.log('Visited /hot, title:', await page.title());
+     // Now try search
+     await page.goto(`https://www.douyin.com/search/${encodeURIComponent(keyword)}`, { waitUntil: 'domcontentloaded', timeout: 15000 });
+     // Check for captcha
+     const captchaFrame = page.frames().find(f => f.url().includes('bytedance.com/verifycenter'));
+     if (captchaFrame) {
+       console.log('Captcha found, attempting to solve slider...');
+       // Try to find and solve the slider
+       for (let attempt = 0; attempt < 3; attempt++) {
+         try {
+           // Wait for slider element to appear
+           await captchaFrame.waitForSelector('[class*="captcha"]', { timeout: 5000 });
+           // Get all elements in the captcha frame
+           const elements = await captchaFrame.evaluate(() => {
+             const all = document.querySelectorAll('*');
+             const info = [];
+             for (const el of all) {
+               if (el.className && typeof el.className === 'string') {
+                 const rect = el.getBoundingClientRect();
+                 if (rect.width > 20 && rect.height > 10) {
+                   info.push({
+                     tag: el.tagName,
+                     cls: el.className.substring(0, 80),
+                     rect: { x: Math.round(rect.x), y: Math.round(rect.y), w: Math.round(rect.width), h: Math.round(rect.height) }
+                   });
+                 }
+               }
+               }
+             }
+             }
+             return info;
+           });
+           console.log('Captcha elements:', JSON.stringify(elements.slice(0, 20)));
+           // Find slider button - typically a small draggable element
+           const slider = elements.find(e =>
+             e.cls.includes('slider') || e.cls.includes('drag') || e.cls.includes('btn')
+           );
+           if (slider) {
+             const { x, y, w, h } = slider.rect;
+             // Calculate absolute position (iframe offset + element position)
+             const iframeBox = await page.evaluate(() => {
+               const iframe = document.querySelector('iframe');
+               if (!iframe) return null;
+               const rect = iframe.getBoundingClientRect();
+               return { x: rect.x, y: rect.y };
+             });
+             if (iframeBox) {
+               const startX = iframeBox.x + x + w / 4;
+               const startY = iframeBox.y + y + h / 2;
+               const endX = iframeBox.x + x + w + 150; // Drag past the track
+               console.log(`Dragging from (${startX}, ${startY}) to (${endX}, ${startY})`);
+               await page.mouse.move(startX, startY);
+               await page.waitForTimeout(200);
+               await page.waitForTimeout(200);
+               await page.mouse.down();
+               await page.waitForTimeout(100);
+               // Move in steps to simulate human-like behavior
+               const steps = 30;
+               for (let i = 1; i <= steps; i++) {
+                 const progress = i / steps;
+                 // Add slight randomness to y
+                 const yOffset = Math.sin(progress * Math.PI) * 3;
+                 await page.mouse.move(
+                   startX + (endX - startX) * progress,
+                   startY + yOffset,
+                   { steps: 1 }
+                 );
+                 await page.waitForTimeout(20 + Math.random() * 30);
+               await page.mouse.up();
+               await page.waitForTimeout(3000);
+               console.log('Slider drag completed, checking result...');
+           }
+         } catch (e) {
+           console.log(`Attempt ${attempt + 1} failed:`, e.message);
+         }
+         }
+         // Check if captcha is gone
