+     @staticmethod
+     def _parse(origin_content: str) -> str:
+         """解析 Lite 格式内容"""
+         soup = BeautifulSoup(origin_content, 'html.parser')
+         body_tag = soup.find('body')
+         if not body_tag:
+             return origin_content
+         pre_tag = body_tag.find('pre')
+         if pre_tag:
+             return pre_tag.get_text()
+         return origin_content

