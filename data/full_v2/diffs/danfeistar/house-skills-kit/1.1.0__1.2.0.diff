+     # ── 输出 ──
+     W = 52
+     out = []
+     out.append("═" * W)
+     out.append("═" * W)
+     out.append("购房能力测算 · 银行双线口径（⑦-5）")
+     out.append(f"家庭月收入 {fmt_money(income)} 元 ｜ 存量负债月供 {fmt_money(args.debts)} 元"
