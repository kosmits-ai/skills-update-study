+     out.append(f"② 首付线：现金 {fmt_money(cash)} ÷ {down_min*100:g}% → 总价上限 "
+                f"{fmt_money(total_cap_down)} 元")
+     out.append(f"★ 可买总价上限 ≈ {fmt_money(total_cap)} 元（瓶颈：{bottleneck}）")
