+ MATCHES=$(grep -rniE "$CRED_PATTERNS" "$WORKSPACE" \
+   --include="*.md" --include="*.json" --include="*.yaml" --include="*.yml" --include="*.txt" \
+   --exclude-dir=".git" --exclude-dir="node_modules" \
