+     Start([User clicks Checkout]) --> Auth{Authenticated?}
+     Auth -->|No| Login[Redirect to login]
+     Login --> Auth
+     Auth -->|Yes| Cart{Cart empty?}
+     Cart -->|Yes| EmptyCart[Show empty cart message]
+     EmptyCart --> Browse[Redirect to products]
