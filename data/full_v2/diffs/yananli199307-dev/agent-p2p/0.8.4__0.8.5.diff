- AGENTP2P_API_KEY=ap2p_xxxxx
- AGENTP2P_HUB_URL=https://your-domain.com
- OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789  # 端口需运行 openclaw status 查看
- OPENCLAW_HOOKS_TOKEN=your-token
