- export AGENTP2P_API_KEY=ap2p_xxxxx
- export AGENTP2P_HUB_URL=https://your-domain.com
- export OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789  # 端口需运行 openclaw status 查看
