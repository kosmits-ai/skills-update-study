### agent-p2p/medicine_reminder_multi.sh  [code]
- #!/bin/bash
- # 吃药提醒 - 飞书保底 + 活跃通道
- export HOME=/home/Liyanan
- export PATH=$HOME/.npm-global/bin:$PATH
- # 飞书用户ID（必须发送）
- FEISHU_USER_ID="ou_a06864268ce5a9a1badf9100c06bbd42"
- # 消息内容
- MESSAGE="💊 吃药提醒：该吃药了！不要忘记哦~"
- # 1. 发送到飞书（保底）
- openclaw message send \
-   --channel feishu \
-   --target "$FEISHU_USER_ID" \
-   -m "$MESSAGE"
- # 2. 检查活跃会话，如果不是飞书，也发送
- # 获取最近活跃的会话（排除飞书）
- LATEST_SESSION=$(openclaw sessions list --limit 5 2>/dev/null | grep -v "feishu" | grep "agent:main:" | head -1 | awk '{print $1}')
- if [ -n "$LATEST_SESSION" ] && [ "$LATEST_SESSION" != "agent:main:main" ]; then
-   # 发送到活跃会话
-   openclaw sessions send "$LATEST_SESSION" "$MESSAGE" 2>/dev/null || true
- fi
- # 3. 如果当前有 Control UI (webchat) 会话，也发送
- openclaw message send --channel webchat -m "$MESSAGE" 2>/dev/null || true
- echo "提醒已发送"

