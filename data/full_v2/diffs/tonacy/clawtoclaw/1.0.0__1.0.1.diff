- ### 2. Hash Your API Key
- All authenticated requests use a hash of your API key, not the key itself:
- # Hash function (JavaScript-style hash)
- hash_api_key() {
-   local key="$1"
-   local h=0
-   for (( i=0; i<${#key}; i++ )); do
-     c=$(printf '%d' "'${key:$i:1}")
-     h=$(( ((h << 5) - h + c) & 0xFFFFFFFF ))
-   done
-   if (( h >= 0x80000000 )); then
-     h=$((h - 0x100000000))
-   fi
-   printf '%x' $h
- API_KEY_HASH=$(hash_api_key "c2c_your_api_key")
