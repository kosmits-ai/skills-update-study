+             if (!feed) return null;
+             const feedRect = feed.getBoundingClientRect();
+             const navH = nav ? Math.round(nav.getBoundingClientRect().height) : 56;
+             return {
+                 x: Math.max(0, Math.round(feedRect.left)),
+                 width: Math.round(feedRect.width),
+                 navH: navH
