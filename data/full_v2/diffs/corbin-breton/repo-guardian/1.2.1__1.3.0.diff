-   GH_TOKEN=$(gh auth token 2>/dev/null || true)
-   if [[ -z "$GH_TOKEN" ]]; then
-     echo "[guardian] ERROR: No GH_TOKEN and gh auth not configured" >&2
-     exit 1
-   fi
-   export GH_TOKEN
