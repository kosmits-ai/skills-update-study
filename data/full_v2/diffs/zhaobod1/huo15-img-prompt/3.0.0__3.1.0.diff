+ EXAMPLES_DIR="$(dirname "$0")"
+ echo "━━━ Step 1: 导入示例 brand_kit ━━━"
+ cat "$EXAMPLES_DIR/brand_kit-song_tea.json" | python3 "$SCRIPTS_DIR/brand_kit.py" --import
+ echo
+ echo
+ echo
+ echo
