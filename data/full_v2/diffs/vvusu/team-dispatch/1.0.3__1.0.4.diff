+ # Required assets sanity-check (important for Clawhub packaging)
+ need_file() {
+   local p="$1"
+   if [ ! -f "$p" ]; then
+     echo "${RED}FAIL${NC}: missing required file: $p"
+     exit 1
+   fi
+ }
+ need_file "$SKILL_DIR/assets/launchd/team-dispatch.watch.plist"
