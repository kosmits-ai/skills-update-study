### scripts/uninstall.sh  [code]
- set -e
-     echo "[dry-run] $*"
-     eval "$@"
-     run "rm \"$LINK\""
-     run "rm -rf \"$AD\""
-   run "rm -f \"$CFG\""
+ set -euo pipefail
+   if [ "$DRY_RUN" = "1" ]; then
+     printf '[dry-run]'; printf ' %q' "$@"; printf '\n'
+   else
+     "$@"
+   fi
+   fi
+ }
+ safe_rm_dir() {
+   local p="$1"
+   if [ ! -e "$p" ]; then return 0; fi
+     printf '[dry-run]'; printf ' %q' "trash" "$p"; printf ' (fallback: rm -rf)\n'
+     return 0
+   if command -v trash >/dev/null 2>&1; then
+     trash "$p"
+     rm -rf "$p"
+     run rm "$LINK"
+     safe_rm_dir "$AD"
+   run rm -f "$CFG"

