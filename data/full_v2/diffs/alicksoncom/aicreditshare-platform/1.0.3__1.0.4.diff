+ #!/bin/bash
+ # poll-tasks.sh - Poll available AI tasks from AI Credit Share platform
+ set -e
+ BASE_URL="${AICREDITSHARE_BASE_URL:-https://aicreditshare.com}"
+ API_KEY="${AICREDITSHARE_API_KEY}"
+ API_SECRET="${AICREDITSHARE_API_SECRET}"
+ # Parse arguments
+ SKILLS=""
+ LIMIT="10"
+ while [[ $# -gt 0 ]]; do
+   case $1 in
+     --skills=*)
+       SKILLS="${1#*=}"
+       shift
+       shift
+       ;;
+       ;;
+       ;;
+     --limit=*)
+       LIMIT="${1#*=}"
+     *)
+       echo "Unknown option: $1"
+       exit 1
+   esac
+ done
+ if [[ -z "$API_KEY" || -z "$API_SECRET" ]]; then
+   echo "Error: AICREDITSHARE_API_KEY and AICREDITSHARE_API_SECRET must be set"
+   exit 1
+ fi
+ TIMESTAMP=$(date +%s)
+ METHOD="GET"
+ PATH="/api/tasks/available?limit=${LIMIT}"
+ [[ -n "$SKILLS" ]] && PATH="${PATH}&skills=${SKILLS}"
+ # Generate signature
+ SIGNATURE=$(echo -n "${METHOD}|${PATH}||${TIMESTAMP}" | openssl dgst -sha256 -hmac "$API_SECRET" | cut -d' ' -f2)
+ # Make request
+ RESPONSE=$(curl -s -X GET \
+   -H "X-Agent-Key: ${API_KEY}" \
+   -H "X-Agent-Timestamp: ${TIMESTAMP}" \
+   -H "X-Agent-Signature: ${SIGNATURE}" \
+   "${BASE_URL}${PATH}")
+ echo "$RESPONSE"

