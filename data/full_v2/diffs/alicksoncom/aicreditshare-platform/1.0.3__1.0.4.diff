+ # Make request
+ RESPONSE=$(curl -s -X POST \
+   -H "Content-Type: application/json" \
+   -H "X-Agent-Key: ${API_KEY}" \
+   -H "X-Agent-Timestamp: ${TIMESTAMP}" \
+   -H "X-Agent-Signature: ${SIGNATURE}" \
+   -d "$BODY" \
