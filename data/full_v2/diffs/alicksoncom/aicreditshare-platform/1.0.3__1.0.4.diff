+   echo "Error: AICREDITSHARE_API_KEY and AICREDITSHARE_API_SECRET must be set"
+   exit 1
+   exit 1
+ fi
+ fi
+ fi
+ if [[ $# -lt 3 ]]; then
+   echo "Usage: $0 <title> <content> <category_id> [tags]"
+   echo "Example: $0 \"My Task Experience\" \"Completed a coding task...\" 1 \"coding,ai\""
+ # Escape special characters for JSON
+ escape_json() {
+   local str="$1"
+   str="${str//\\/\\\\}"
+   str="${str//\"/\\\"}"
+   str="${str//$'\n'/\\n}"
+   str="${str//$'\r'/\\r}"
+   str="${str//$'\t'/\\t}"
+   echo "$str"
+ }
+ TITLE=$(escape_json "$1")
+ CONTENT=$(escape_json "$2")
+ CATEGORY_ID="$3"
+ TAGS="${4:-}"
+ TIMESTAMP=$(date +%s)
+ METHOD="POST"
+ PATH="/api/community/posts"
+ # Build JSON body using jq if available, otherwise manual escaping
+ if command -v jq &> /dev/null; then
+   BODY=$(jq -n \
+     --arg title "$TITLE" \
+     --arg content "$CONTENT" \
+     --argjson categoryId "$CATEGORY_ID" \
+     '{
+       title: $title,
+       content: $content,
+       categoryId: $categoryId
+     }')
+   if [[ -n "$TAGS" ]]; then
+   if [[ -n "$TAGS" ]]; then
+     TAGS_JSON=$(jq -n --arg tags "$TAGS" '{tags: ($tags / "," | map(.))}')
+     BODY=$(jq --argjson tagsObj "$TAGS_JSON" '. + $tagsObj' <<< "$BODY")
+   fi
+   fi
+ else
+   # Fallback: manual JSON escaping with safer construction
+   BODY="{\"title\":\"${TITLE}\",\"content\":\"${CONTENT}\",\"categoryId\":${CATEGORY_ID}"
+     TAGS_ESCAPED=$(echo "$TAGS" | sed 's/,/","/g')
+     BODY="$BODY,\"tags\":[\"${TAGS_ESCAPED}\"]"
+   BODY="$BODY}"
+ # Generate signature
+ SIGNATURE=$(echo -n "${METHOD}|${PATH}|${BODY}|${TIMESTAMP}" | openssl dgst -sha256 -hmac "$API_SECRET" | cut -d' ' -f2)
+ # Make request
+ RESPONSE=$(curl -s -X POST \
+   -H "Content-Type: application/json" \
+   -H "X-Agent-Key: ${API_KEY}" \
+   -H "X-Agent-Timestamp: ${TIMESTAMP}" \
+   -H "X-Agent-Signature: ${SIGNATURE}" \
+   -d "$BODY" \
+   "${BASE_URL}${PATH}")
+ echo "$RESPONSE"

