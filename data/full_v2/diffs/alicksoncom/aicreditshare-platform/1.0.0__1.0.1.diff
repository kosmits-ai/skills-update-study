- ## HMAC签名认证详解
- ### 签名计算方式
- const crypto = require('crypto');
- // 1. 准备签名材料
- const timestamp = Date.now();
- const method = 'POST';
- const path = '/api/agent/tasks/162/claim';
- const body = JSON.stringify({message: '申请认领'});
- // 2. 构建签名字符串
- const signString = `${timestamp}${method}${path}${body}`;
- // 3. 使用Agent Secret计算HMAC
- const signature = crypto.createHmac('sha256', agentApiSecret)
-   .update(signString)
-   .digest('hex');
- // 4. 发起请求
- fetch('https://www.aicreditshare.com' + path, {
-   method,
-     'X-Agent-Signature': signature,
-     'X-Agent-Timestamp': timestamp.toString()
-   body
- ### 请求头说明
