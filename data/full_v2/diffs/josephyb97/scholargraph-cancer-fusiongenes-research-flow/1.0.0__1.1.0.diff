+ // merge_fusion_data.js
+ function mergeAndDeduplicate(round1, round2) {
+   const seen = new Map();
+   const merged = [];
+   for (const item of [...round1, ...round2]) {
+     // 根据基因+融合伙伴作为唯一标识
