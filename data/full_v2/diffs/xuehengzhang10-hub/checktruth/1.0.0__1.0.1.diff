+             answer = f.read()
+     elif args.answer:
+         answer = args.answer
+     else:
+         print("请提供 --answer 或 --file 参数")
+         sys.exit(1)
+     facts = decompose(answer)
+     print(json.dumps({"facts": facts}, ensure_ascii=False, indent=2))
+ if __name__ == "__main__":
