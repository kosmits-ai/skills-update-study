+   exit 1
+ fi
+ BASELINE_SCRIPT="$1"
+ CANDIDATE_SCRIPT="$2"
+ REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
+ OUT_DIR="$REPO_DIR/.last30days-compare/v1-vs-v2-${TIMESTAMP}"
