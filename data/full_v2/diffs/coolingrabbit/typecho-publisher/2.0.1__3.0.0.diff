+         payload["category"] = args.category
+     result = api_call(domain, token, payload)
+     result = api_call(domain, token, payload)
+     result = api_call(domain, token, payload)
+     result = api_call(domain, token, payload)
+     result = api_call(domain, token, payload)
+     print(json.dumps(result, ensure_ascii=False, indent=2))
+     print(json.dumps(result, ensure_ascii=False, indent=2))
+     print(json.dumps(result, ensure_ascii=False, indent=2))
+     print(json.dumps(result, ensure_ascii=False, indent=2))
+     print(json.dumps(result, ensure_ascii=False, indent=2))
+ def cmd_get(args):
