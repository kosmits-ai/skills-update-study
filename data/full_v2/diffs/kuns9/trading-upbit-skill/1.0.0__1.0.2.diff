+ /**
+ /**
+  * eventHandler.js
+  * OpenClaw Trigger Handler - Replaces eventWorker.js loop
+  */
+  */
+ const OpenClawAdapter = require('../adapter/openclawAdapter');
+ const OrderService = require('../execution/orderService');
+ const TradeExecutor = require('../execution/tradeExecutor');
+  * OpenClaw Handler
+ const handler = async (context) => {
+     const { tools } = context;
+     const adapter = new OpenClawAdapter(tools);
+     const orderService = new OrderService(adapter);
+     const executor = new TradeExecutor(orderService);
+     try {
+         const data = await adapter.storageGet('events');
+         let events = data ? JSON.parse(data) : [];
+         const pendingEvents = events.filter(e => !e.processed);
+         if (pendingEvents.length === 0) return;
+         console.log(`⚙️ 이벤트 처리 시작: ${pendingEvents.length}건`);
+         for (const event of pendingEvents) {
+             try {
+                 const success = await executor.execute(adapter, event);
+                 if (success) {
+                     event.processed = true;
+                     event.processed = true;
+                     event.processedAt = new Date().toISOString();
+                 } else {
+                     // 리스크 등에 의해 거부된 경우도 처리 완료로 표시 (중복 실행 방지)
+                 }
+             } catch (err) {
+                 console.error(`Event Process Error (${event.id}): ${err.message}`);
+             }
+         }
+         await adapter.storageSet('events', JSON.stringify(events));
+     } catch (err) {
+         console.error(`Event Handler Error: ${err.message}`);
+     }
+ }
+ module.exports = { handler };

