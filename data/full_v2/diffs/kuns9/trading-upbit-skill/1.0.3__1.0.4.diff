- domain/
-   strategies.js         # 변동성 돌파 전략 수식 (Pure Logic)
-   riskManager.js        # 계좌 잔고 및 주문 가능 여부 검증
- adapters/
-   execution.js          # OpenClaw Tools 래퍼 레이어
- services/
