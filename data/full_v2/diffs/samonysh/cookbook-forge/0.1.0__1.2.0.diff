+   if (eocdOff < 0) throw new Error("EOCD 未找到，ZIP 损坏");
+   const cdEntries = buf.readUInt16LE(eocdOff + 10);
+   const cdSize = buf.readUInt32LE(eocdOff + 12);
+   const cdStart = buf.readUInt32LE(eocdOff + 16);
