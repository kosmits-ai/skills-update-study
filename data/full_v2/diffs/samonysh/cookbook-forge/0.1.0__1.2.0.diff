+   if (!srcDir || !outFile) {
+     console.error("用法：node epub-zip.mjs <src_dir> <out.epub>");
+     process.exit(1);
+     process.exit(1);
+   buildEpub(srcDir, outFile).catch(err => {
+     console.error("✗ 构建失败：", err.message);
+   });

