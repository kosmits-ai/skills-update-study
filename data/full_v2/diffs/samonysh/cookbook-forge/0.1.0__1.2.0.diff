+   // 2) 收集所有文件，强制 mimetype 在最前
+   const allFiles = await walkDir(srcDir);
+   const ordered = [];
+   const rest = [];
+   for (const f of allFiles) {
+     if (f.rel === "mimetype") ordered.unshift(f);
