+   svgbob: "svgbob",
+   erd: "erd",
+   ditaa: "ditaa",
+   bytefield: "bytefield",
+   seqdiag: "seqdiag",
+   actdiag: "actdiag",
+   nwdiag: "nwdiag",
+   packetdiag: "packetdiag",
+   rackdiag: "rackdiag",
