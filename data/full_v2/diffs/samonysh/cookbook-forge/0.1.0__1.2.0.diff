+  */
+  */
+  */
+ export function extractDiagramBlocks(mdxBody) {
+   const blocks = [];
+   // 围栏代码块（支持 ``` 或 ~~~），语言标记 = mermaid / plantuml / puml
+   const re = /(^|\n)(```|~~~)(mermaid|plantuml|puml)\s*\n([\s\S]*?)\n\2(\s*\n)?/g;
