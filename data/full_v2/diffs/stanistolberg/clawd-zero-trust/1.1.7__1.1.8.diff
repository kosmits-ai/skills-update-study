+     echo "$merged" | jq '{plugins: .plugins, tools: .tools, gateway: .gateway, plp: .plp}'
+     return 0
+   backup="$CONFIG.bak.hardening.$(date -u +%Y%m%d%H%M%S)"
+   cp "$CONFIG" "$backup" || {
+     fail "Failed to create backup: $backup"
+   info "Backup created: $backup"
+   tmp=$(mktemp)
