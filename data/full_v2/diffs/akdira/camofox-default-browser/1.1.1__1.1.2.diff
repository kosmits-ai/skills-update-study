+ #!/bin/bash
+ # Monitor Camoufox memory over time
+ while true; do
+   MEM=$(ps aux | grep '[c]amoufox' | awk '{sum+=$6} END {printf "%.0f MB\n", sum/1024}')
+   TABS=$(curl -s http://localhost:9377/tabs 2>/dev/null | grep -c '"tabId"' || echo 0)
