+ # Auth: set WITHINGS_CLIENT_ID / WITHINGS_CLIENT_SECRET in environment,
+ # or put them in workspace/withings-family/config.json.
+ def _load_config_json() -> dict:
+     cfg_path = BASE_DIR / 'config.json'
+     if cfg_path.exists():
+         import json as _json
