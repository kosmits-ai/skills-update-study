+ #!/usr/bin/env python3
+ # -*- coding: utf-8 -*-
+ """
+ """
+ 从 itick.org API 获取XAUUSD真实K线数据
+ kType: 1=1分钟, 2=5分钟, 3=15分钟, 4=30分钟, 5=1小时, 8=日线
+ import requests
