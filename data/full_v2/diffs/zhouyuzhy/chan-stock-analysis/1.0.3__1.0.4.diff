+     if not new_klines:
+         return old_klines[-max_count:] if old_klines else None
+     # 创建时间索引
+     old_times = {k['datetime']: k for k in old_klines}
+     # 合并数据
+     merged = list(old_klines)
+     for k in new_klines:
+         dt = k['datetime']
