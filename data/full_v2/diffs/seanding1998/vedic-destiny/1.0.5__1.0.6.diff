+ def _parse_ashtakavarga_compact(grid: list[list[str]]) -> dict[str, Any] | None:
+     """Extract SAV from JHora compact Ashtakavarga format.
+     The compact format uses 12 physical rows x 12 cols with embedded labels.
+     Empirically, the first row (row 0) contains SAV values scaled by a factor
+     of approximately 2.5× (varies 2.48-2.74 across charts).
+     Strategy: SAV[sign] = row0[sign] * 337 / sum(row0)
+     This consistently gives SAV sums within ±3 of 337.
+     BAV row extraction is not currently supported for the compact format;
+     use BAV constants from chart_sanity_check.py instead.
+     nrows = len(grid)
+     if nrows < 10:
+     ncols = max(len(row) for row in grid) if grid else 0
+     if ncols < 10:
+     # Extract the first row as scaled SAV values
+     row0: list[float] = []
+     for cell in grid[0][:12]:
+             row0.append(float(str(cell).strip()))
+             return None
+     if len(row0) < 12:
+     row0_sum = sum(row0)
+     if row0_sum <= 0:
+     # Scale: the first row values represent SAV divided by ~2.5
+     scale = 337.0 / row0_sum
+     sav = [round(v * scale) for v in row0]
+     # Verify sum is close to 337
+     if abs(sum(sav) - 337) > 5:
+     result: dict[str, Any] = {"sav": [float(v) for v in sav]}
+     # --- Also extract BAV from pure data rows ---
+     # In the compact format, rows that are entirely numeric with all values
+     # in the 0-8 range are BAV rows for specific planets. Their row sums
+     # approximate known BAV constants (within ±3).
+     BAV_CONSTANTS = {
+         "Sun": 48, "Moon": 49, "Mars": 39,
+         "Mercury": 54, "Jupiter": 56, "Venus": 52, "Saturn": 39,
+     }
+     bav: dict[str, list[float]] = {}
+     for r in range(nrows):
+         vals: list[float] = []
+             for c in range(min(ncols, len(grid[r]))):
+                 v = float(str(grid[r][c]).strip())
+                 if v < 0 or v > 8:
+                     raise ValueError("not BAV")
+                 vals.append(v)
+         except (ValueError, IndexError):
+         if len(vals) != ncols:
+         row_sum = sum(vals)
+         # Match to closest BAV constant
+         best_planet, best_diff = None, 99
+         for planet, const in BAV_CONSTANTS.items():
+             if planet in bav:
+                 continue  # already assigned
+             diff = abs(row_sum - const)
+             if diff < best_diff:
+                 best_diff = diff
+                 best_planet = planet
+         if best_planet and best_diff <= 5:
+             bav[best_planet] = vals
+     if bav:
+         result["bav"] = bav
+     # --- Strategy 3: JHora compact format with embedded labels ---
+     return _parse_ashtakavarga_compact(grid)
