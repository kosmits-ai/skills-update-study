### backend/start.sh  [code]
+ # 设置 Node.js 全局模块路径（pywencai 依赖 jsdom）
+ export NODE_PATH=$(npm root -g 2>/dev/null)
+ if [ -n "$NODE_PATH" ]; then
+     echo "✅ Node.js 模块路径: $NODE_PATH"
+ else
+     echo "⚠️  未找到 Node.js，请运行: npm install -g jsdom"
+ fi

### scripts/install.sh  [code]
+ echo ""
