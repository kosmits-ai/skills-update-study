-     ("worker_2", "summarise_document"),
-     ("worker_3", "translate_text"),
-     ("worker_4", "generate_embeddings"),
- ]
- print("Coordinator dispatching tasks…\n")
- for idx, (worker_id, task_name) in enumerate(tasks):
