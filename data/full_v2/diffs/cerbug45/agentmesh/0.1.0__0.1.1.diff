- workers = [Agent(f"worker_{i}", hub=hub) for i in range(1, 5)]
- all_logs: list = []
- # ── Worker handler: receive task → reply with result ─────────────────────────
- for worker in workers:
-     @worker.on_message
-     def handle_task(msg, w=worker):
-         task   = msg.payload.get("task", "?")
