- echo -e "\n### CRASH LOOP DETECTION ###" >&2
- CRASH_LOOPS=$($CLI get pods -A 2>/dev/null | grep -c "CrashLoopBackOff" || echo 0)
- if [ "$CRASH_LOOPS" -gt 0 ]; then
