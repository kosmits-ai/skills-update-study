-     fi
- # Ensure score doesn't go below 0
- if [ "$SCORE" -lt 0 ]; then
-     SCORE=0
- # Output summary
- echo "========================================" >&2
- echo "========================================" >&2
- echo "CLUSTER HEALTH SCORE: $SCORE/100" >&2
- if [ ${#ISSUES[@]} -gt 0 ]; then
