+         else
+             echo "✓ $APP is synced" >&2
+             echo "✓ $APP is synced" >&2
+             SYNCED_APPS=1
+             SYNCED_APPS=1
+         fi
+         fi
+         fi
+         TOTAL_APPS=1
+         TOTAL_APPS=1
+     else
+     else
