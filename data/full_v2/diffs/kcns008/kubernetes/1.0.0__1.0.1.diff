+ [ $SCORE -lt 0 ] && SCORE=0
+ # Summary
+ echo "========================================" >&2
+ echo "========================================" >&2
+ echo "CLUSTER HEALTH SCORE: $SCORE/100" >&2
+ if [ $SCORE -ge 90 ]; then
+     echo "Status: ✅ HEALTHY" >&2
+ elif [ $SCORE -ge 70 ]; then
+     echo "Status: ⚠️  WARNING" >&2
+ elif [ $SCORE -ge 50 ]; then
