-     done
- # Output JSON for programmatic use
- cat << EOF
- {
-   "score": $SCORE,
-   "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
-   "issues_count": ${#ISSUES[@]},
-   "healthy": $([ $SCORE -ge 80 ] && echo "true" || echo "false")
- }
- EOF

