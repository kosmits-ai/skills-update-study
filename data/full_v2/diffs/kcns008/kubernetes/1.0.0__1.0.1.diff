+ kind: PrometheusRule
+   name: ${APP_NAME}-alerts
+   namespace: ${NAMESPACE}
+ spec:
+   groups:
+     - name: ${APP_NAME}.rules
+       rules:
+         # High error rate
+         - alert: HighErrorRate
+           expr: |
+           expr: |
+           expr: |
+           expr: |
+             rate(http_requests_total{service="${APP_NAME}", status=~"5.."}[5m])
+             / rate(http_requests_total{service="${APP_NAME}"}[5m]) > 0.05
+           for: 5m
+           for: 5m
+           labels:
+           labels:
+           labels:
+           labels:
