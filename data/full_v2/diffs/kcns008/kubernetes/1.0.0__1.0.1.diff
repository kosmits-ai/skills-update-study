+     echo "Status: 🔴 CRITICAL" >&2
+ if [ ${#ISSUES[@]} -gt 0 ]; then
+     echo "" >&2
+     echo "Issues found:" >&2
+     for issue in "${ISSUES[@]}"; do
+         echo "  - $issue" >&2
+     done
