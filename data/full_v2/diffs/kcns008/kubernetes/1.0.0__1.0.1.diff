+ elif [ "$FORMAT" == "cyclonedx-json" ]; then
+     PACKAGE_COUNT=$(jq '.components | length' "$OUTPUT_FILE" 2>/dev/null || echo 0)
+     LICENSES=$(jq -r '[.components[].licenses[]?.license?.id? // empty] | unique | join(", ")' "$OUTPUT_FILE" 2>/dev/null || echo "unknown")
