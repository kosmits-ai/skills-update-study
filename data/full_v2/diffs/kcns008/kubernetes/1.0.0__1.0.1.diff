+ echo "========================================" >&2
+ echo "NODE MAINTENANCE READY" >&2
+ echo "Node '$NODE' is now cordoned and drained." >&2
+ echo "Perform your maintenance tasks, then run:" >&2
+ echo "  $CLI uncordon $NODE" >&2
+ # Output JSON
+ cat << EOF
