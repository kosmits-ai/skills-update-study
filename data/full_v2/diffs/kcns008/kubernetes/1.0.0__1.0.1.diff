+         if [ "$SYNC_STATUS" != "Synced" ]; then
+         if [ "$SYNC_STATUS" != "Synced" ]; then
+             echo "⚠️  DRIFT DETECTED: $APP (Sync: $SYNC_STATUS, Health: $HEALTH_STATUS)" >&2
+             echo "⚠️  DRIFT DETECTED: $APP (Sync: $SYNC_STATUS, Health: $HEALTH_STATUS)" >&2
+             argocd app diff "$APP" >&2 || true
+             DRIFTED_APPS+=("$APP")
+             DRIFTED_APPS+=("$APP")
