+         except subprocess.TimeoutExpired:
+             print("[KataGomo] Timeout!")
+             return None, None, None, "超时"
+         except Exception as e:
+             print(f"[KataGomo] Error: {e}")
+             return None, None, None, str(e)
+         finally:
+             try:
+                 os.remove(cmd_file)
+             except:
+                 pass
