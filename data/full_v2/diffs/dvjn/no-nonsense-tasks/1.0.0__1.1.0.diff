- #!/bin/bash
- DB_PATH="${TASKS_DB:-$HOME/.no-nonsense/tasks.db}"
- if [ ! -f "$DB_PATH" ]; then
-     echo "Error: Database not initialized. Run init_db.sh first."
-     exit 1
-     exit 1
-     echo "Usage: task_filter.sh <tag>"
- sqlite3 -header -column "$DB_PATH" <<EOF
- WHERE tags LIKE '%$TAG%'
- ORDER BY
-     CASE status
-         WHEN 'in-progress' THEN 1
-         WHEN 'todo' THEN 2
-         WHEN 'backlog' THEN 3
-         WHEN 'done' THEN 4
-     END,
