+ 		echo "                           Default: backlog"
+ 		echo "Examples:"
+ 		echo "  task_add.sh \"Fix bug\""
+ 		echo "  task_add.sh \"Review PR\" --description \"Check auth changes\" --tags \"urgent,review\""
+ 		echo "  task_add.sh \"Deploy\" --status todo --tags \"critical\""
+ 		exit 0
