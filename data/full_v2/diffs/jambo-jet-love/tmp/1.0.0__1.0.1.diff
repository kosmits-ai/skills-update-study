+ package cmd
+ import "strings"
+ func splitCSV(s string) []string {
+ 	s = strings.TrimSpace(s)
+ 	if s == "" {
+ 		return nil
+ 	}
+ 	}
+ 	parts := strings.Split(s, ",")
+ 	out := make([]string, 0, len(parts))
+ 	for _, p := range parts {
+ 		p = strings.TrimSpace(p)
+ 		if p != "" {
+ 			out = append(out, p)
+ 		}
+ 	return out
+ }

