### .env.example  [code]
+ # Speechify TTS — Credentials
+ # Copy this to .env and fill in your values.
+ # .env is gitignored — never commit real credentials.
+ # Speechify API key (required for primary TTS)
+ # Get one at https://platform.speechify.ai/api-keys
+ SPEECHIFY_API_KEY="sk_..."
+ # Voice configuration (optional — defaults shown)
+ SPEECHIFY_VOICE="cristiane"          # see docs/voices.md for available voices
+ SPEECHIFY_MODEL="simba-multilingual"
+ SPEECHIFY_LANG="pt-BR"
+ # Edge TTS fallback (optional)
+ EDGE_TTS_VOICE="pt-BR-FranciscaNeural"
+ EDGE_TTS_CMD="edge-tts"
+ # Output (optional)
+ SPEECHIFY_OUTPUT="/tmp/speech-output.ogg"
+ # Vault item name (optional — only if using vault-resolver)
+ SPEECHIFY_VAULT_ITEM="speechfy_key"
+ VAULT_RESOLVER="vault-resolver"

