+ def run_mcporter(tool: str, args: dict = None, timeout: int = 60) -> Tuple[bool, str]:
+     执行 mcporter 命令（使用 --args JSON 传参）
+         tool: 工具名称，如 dingtalk-docs.get_my_docs_root_dentry_uuid
