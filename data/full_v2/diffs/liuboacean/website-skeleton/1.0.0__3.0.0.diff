+ ```json
+ {
+ {
+ {
+   "name": "my-geek-mall",
+   "output": "./dist",
+   "env": "production",
+   "routes": [
+     {
+     {
+     {
+       "pattern": "/api/*",
+       "target": "edge-functions"
+     },
+       "pattern": "/api/pay/*",
+       "target": "cloud-functions"
+     }
