+ ## 构建时同步（sync-sharing.js）
+ 在部署前，将 `sharing/` 目录中的类型定义同步到 Edge Functions 和 Cloud Functions：
+ ```javascript
+ // scripts/sync-sharing.js
+ const fs = require('fs');
+ const path = require('path');
+ const sharing = path.join(__dirname, '../sharing');
+ const edge = path.join(__dirname, '../edge-functions/sharing');
+ const cloud = path.join(__dirname, '../cloud-functions/sharing');
+ [edge, cloud].forEach(target => {
+   fs.mkdirSync(target, { recursive: true });
+   fs.readdirSync(sharing).forEach(file => {
+     fs.copyFileSync(path.join(sharing, file), path.join(target, file));
+   });
+ });
+ 运行：`node scripts/sync-sharing.js`（在 `npm run build` 之后、`edgeone deploy` 之前）
