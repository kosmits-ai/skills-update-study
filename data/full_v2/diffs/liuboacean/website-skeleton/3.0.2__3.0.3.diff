+ JWT_PRIVATE_KEY="$(cat keys/private.pem | tr '\n' ' ')"
+ JWT_PUBLIC_KEY="$(cat keys/public.pem | tr '\n' ' ')"
+ JWT_SECRET=local-dev-secret
+ # D1 数据库绑定由 EdgeOne Pages 平台自动注入
+ EDGE_BASE=http://localhost:8787
+ ## 八、回滚与监控
+ ### 回滚
