            "summary": "This skill is a disclosed website monitor that can create scheduled checks and use existing Vercel/GA4 credentials, and those powers are purpose-aligned and user-directed.",
            "dimensions": [
              {
                "detail": "The skill performs network checks only against configured watch URLs and reads OpenClaw configuration for delegated Vercel/GA4 credentials when those modules are used. This is sensitive but disclosed and bounded to the monitoring purpose.",
                "label": "Credentials",
                "name": "environment_proportionality",
