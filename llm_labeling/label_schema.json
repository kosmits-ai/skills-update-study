{
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "pattern": "^[0-9]{1,2}$",
      "description": "One or two category codes, most important first, e.g. \"3\" or \"56\"."
    },
    "security_relevant": {"type": "string", "enum": ["y", "n", "u"]},
    "security_direction": {"type": "string", "enum": ["expands", "reduces", "neutral"]},
    "declared": {"type": "string", "enum": ["yes", "partial", "no", "na"]},
    "changelog_kind": {"type": "string", "enum": ["specific", "boilerplate", "machine_synced", "empty"]},
    "features": {
      "type": "object",
      "description": "One verdict for EVERY detected feature listed in the input, keyed by feature name.",
      "additionalProperties": {"type": "string", "enum": ["c", "w", "u"]}
    },
    "notes": {"type": "string"},
    "reason": {"type": "string"}
  },
  "required": ["category", "security_relevant", "security_direction", "declared",
               "changelog_kind", "features", "notes", "reason"],
  "additionalProperties": false
}
