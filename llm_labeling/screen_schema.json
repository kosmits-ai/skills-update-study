{
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "pattern": "^[0-9]{1,2}$",
      "description": "One or two category codes, most important first, e.g. \"3\" or \"56\"."
    },
    "security_relevant": {
      "type": "string",
      "enum": [
        "y",
        "n",
        "u"
      ]
    },
    "security_direction": {
      "type": "string",
      "enum": [
        "expands",
        "reduces",
        "neutral"
      ]
    },
    "declared": {
      "type": "string",
      "enum": [
        "yes",
        "partial",
        "no",
        "na"
      ]
    },
    "changelog_kind": {
      "type": "string",
      "enum": [
        "specific",
        "boilerplate",
        "machine_synced",
        "empty"
      ]
    },
    "changelog_accuracy": {
      "type": "string",
      "enum": [
        "accurate",
        "incomplete",
        "misleading",
        "empty"
      ]
    },
    "patterns": {
      "type": "array",
      "description": "Every pattern this update introduces or changes (codebook section 9); empty list if none.",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "enum": [
              "remote_instruction_loading",
              "unpinned_remote_exec",
              "credential_access",
              "data_egress",
              "persistence_privilege",
              "concealment",
              "instruction_override",
              "safeguard_removal",
              "agent_config_change",
              "obfuscation"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "The one diff line showing it, with its '+ ' or '- ' prefix, at most 150 characters."
          }
        },
        "required": [
          "pattern",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "security_relevant",
    "security_direction",
    "declared",
    "changelog_kind",
    "changelog_accuracy",
    "patterns",
    "notes",
    "reason"
  ],
  "additionalProperties": false
}
